public/javascripts/unitegallery.js linguist-vendored
conf/*.properties.* linguist-language=INI
conf/messages.* linguist-language=INI

# The benchmark server image runs these files on Linux
bench/** text eol=lf

# Deployment tooling and systemd files execute on the Linux production server.
scripts/deployment/** text eol=lf
bin/wlxjury-*.sh text eol=lf
conf/systemd/** text eol=lf
conf/wlxjury/** text eol=lf
conf/apache/wlxjury-maintenance.conf text eol=lf

# Twirl renders a template's text as it is checked out. The inline scripts are allowed by their
# SHA-256 in the content security policy (conf/application.conf), so every checkout, Windows
# (core.autocrlf) included, must render the same bytes (views.InlineScriptHashesSpec).
app/views/** text eol=lf
