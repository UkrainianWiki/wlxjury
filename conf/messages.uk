# особисті API-токени у профілі (apiTokens.scala.html)
api.tokens = API-токени
api.tokens.help = Особисті токени дають вашим інструментам командного рядка доступ до API (/api/docs) від вашого імені, з вашими ролями. Тримайте їх у таємниці, як пароль.
api.tokens.none = У вас немає API-токенів.
api.tokens.of = API-токени користувача {0}
api.tokens.user.none = У цього користувача немає API-токенів.
api.tokens.revoke.all = Відкликати всі
api.tokens.revoked.count = Відкликано токенів: {0}.
api.token.name = Назва
api.token.prefix = Токен
api.token.created.at = Створено
api.token.last.used = Останнє використання
api.token.not.used = Не використовувався
api.token.expires = Діє до
api.token.expiry = Термін дії
api.token.expiry.30 = 30 днів
api.token.expiry.90 = 90 днів
api.token.expiry.365 = 1 рік
api.token.expiry.never = Безстроково
api.token.state = Стан
api.token.state.revoked = Відкликано
api.token.state.expired = Прострочено
api.token.revoke = Відкликати
api.token.revoked = Токен відкликано.
api.token.create = Створити токен
api.token.created = Ваш новий токен. Скопіюйте його зараз: більше його не буде показано.
api.token.new = Новий API-токен
api.token.copy = Копіювати
api.token.copied = Скопійовано
error.api.token.not.found = Такого API-токена немає.
error.api.token.expiry = Виберіть один із запропонованих термінів.
error.api.token.already.submitted = Цю форму вже надіслано: новий токен не створено. Створіть його нижче, якщо потрібно.
error.api.token.limit = У вас уже {0} дійсних токенів, це найбільше дозволене. Відкличте один, щоб створити новий.

# облікові записи: запрошення, посилання для пароля, зміна адреси, встановлення (безпековий пакет S2)
not.a.member.invitation = Ще немає облікового запису? Облікові записи створюють організатори конкурсу, які надсилають вам запрошення електронною поштою.
setup.needed = У цьому встановленні ще немає облікових записів. Адміністратор створює перший на сторінці встановлення (див. посібник із розгортання).
account.link.invalid.title = Цим посиланням не можна скористатися
account.link.invalid = Посилання недійсне, застаріло або вже використане. Попросіть організатора вашого конкурсу надіслати нове.
invitation.title = Встановіть пароль
invitation.reset.title = Встановіть новий пароль
invitation.set.password = Виберіть пароль для входу до інструменту журі. Ваша адреса електронної пошти — ваш логін.
invitation.replaces.password = Виберіть новий пароль. Він замінить старий пароль цього облікового запису і завершить усі інші його сеанси.
invitation.submit = Зберегти пароль і увійти
new.password = Новий пароль
current.password = Поточний пароль
current.password.explain = Потрібен, щоб змінити пароль або адресу електронної пошти.
passwords.differ = Паролі не збігаються.
password.current.wrong = Поточний пароль неправильний.
password.others.not.allowed = Пароль може встановити лише сама людина. Root може надіслати їй посилання, щоб встановити новий.
email.change.title = Нова адреса електронної пошти
email.change.confirm = Зробити {0} адресою вашого облікового запису в інструменті журі?
email.change.confirm.button = Підтвердити нову адресу
email.change.done = Ваша адреса електронної пошти тепер {0}. Увійдіть із нею.
email.change.explain = Нова адреса набуде чинності, коли ви перейдете за посиланням, надісланим на неї.
email.change.sent = Посилання для підтвердження надіслано на нову адресу. Вона набуде чинності після переходу за ним.
email.change.subject = Підтвердіть нову адресу електронної пошти для інструменту журі
email.change.body = Перейдіть за цим посиланням протягом {1} год., щоб зробити цю адресу адресою вашого облікового запису в інструменті журі:\n{0}\n\nЯкщо ви цього не просили, проігноруйте лист.
user.email.change.ask.user = Адресу облікового запису, що має пароль, може змінити лише його власник (або root).
setup.title = Встановлення інструменту журі
setup.explain = Створіть перший обліковий запис, адміністратора (root), за допомогою токена встановлення з конфігурації сервера.
setup.token = Токен встановлення
setup.submit = Створити обліковий запис
setup.token.invalid = Токен встановлення неправильний.
invitation.subject = Запрошення до журі {0}
invitation.body = Вітаємо!\n\n{1} запрошує вас до журі {0}.\nПерейдіть за цим посиланням протягом {3} дн., щоб встановити пароль і увійти:\n{2}\n\nВаша адреса електронної пошти — ваш логін.
invitation.subject.tool = Запрошення до інструменту журі
invitation.body.tool = Вітаємо!\n\nПерейдіть за цим посиланням протягом {1} дн., щоб встановити пароль і увійти до інструменту журі:\n{0}\n\nВаша адреса електронної пошти — ваш логін.
invitation.link = Перейдіть за цим посиланням протягом {1} дн., щоб встановити пароль і увійти:\n{0}
password.link.subject = Встановіть новий пароль для інструменту журі
password.link.body = Вітаємо!\n\nПерейдіть за цим посиланням протягом {1} дн., щоб встановити новий пароль для інструменту журі:\n{0}\n\nДо того часу діє поточний пароль. Якщо ви цього не очікували, проігноруйте лист.
password.link.sent = Посилання для встановлення нового пароля надіслано на адресу облікового запису. Поточний пароль діє, доки ним не скористаються.
password.link.not.sent = Не вдалося надіслати посилання. Спробуйте пізніше.
password.link.no.email = Обліковий запис не має адреси електронної пошти, тож посилання не можна надіслати.
wiki.account.invalid = Це недійсне ім''я користувача вікі.
wiki.account.taken = Цей вікі-обліковий запис уже має інший обліковий запис.
wiki.account.own.readonly = Ваш вікі-обліковий запис поки не можна змінити тут; зверніться до адміністратора конкурсу.
wiki.account.unverified.hint = Не перевірено: будь-хто міг ввести цей вікі-обліковий запис.
email.unverified.hint = Не перевірено: власник цієї адреси ще не прийняв запрошення. Роль для цього облікового запису чекає, доки він це зробить.
unverified = не перевірено
role.needs.invitation.email = Цей обліковий запис не підтвердив адресу і не має адреси для запрошення: роль не можна надати.
invitation.send = Надіслати запрошення ще раз
invitation.sent = Запрошення надіслано. Роль діятиме після того, як його приймуть.
invitation.not.sent = Не вдалося надіслати запрошення. Спробуйте пізніше.
invitation.not.possible = Цьому обліковому запису не можна надіслати запрошення.
invitations.pending = Ще не прийняті запрошення
invitation.expires = Діє до
users.invited = Запрошено (роль надається після прийняття запрошення): {0}.
users.not.added.wiki.unverified = Не додано, бо вікі-обліковий запис належить обліковому запису, що його не підтвердив: {0}. Додайте їх за електронною поштою.
users.invitations.not.sent = Запрошень, які не вдалося надіслати: {0}.
invitation.password.placeholder = той, який ви виберете за посиланням нижче
invitation.cancel = Скасувати
invitation.cancelled = Запрошення скасовано.
root.needs.verified.email = Root можна надати лише обліковому запису, власник якого підтвердив адресу (прийняте запрошення або посилання для пароля).
email.changed.subject = Адресу електронної пошти вашого облікового запису в інструменті журі змінено
email.changed.body = Вітаємо!\n\nАдресу електронної пошти вашого облікового запису в інструменті журі змінено на {0}.\n\nЯкщо це були не ви, негайно зверніться до організатора конкурсу.
