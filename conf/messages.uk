coi.no.wiki.account = немає вікі-облікового запису, конфлікт інтересів не перевіряється
coi.files = Конфлікт інтересів
coi.exclude = Не включати файли з конфліктом інтересів
coi.count = {0} файлів конкурсу мають конфлікт інтересів (їх автори — учасники конкурсу або root).
coi.count.round = {0} файлів цього раунду мають конфлікт інтересів, у конкурсі — {1} (їх автори — учасники конкурсу або root).
coi.exclude.edit = Якщо позначити для раунду, що їх ще не виключав, збереження дискваліфікує їх, зберігаючи оцінки окремо (лише коли раунд зупинено; у відкритому раунді їх не включатимуть лише подальші розподіли). Нові збіги дискваліфікуються на сторінці конфлікту інтересів раунду. Якщо ні, подальші розподіли можуть їх додати.
coi.exclude.confirm = Дискваліфікувати в цьому раунді {0} файлів з конфліктом інтересів? Їх оцінки зберігаються окремо і повертаються, якщо файл повторно допущено.
coi.without.author = {0} файлів конкурсу без автора.
coi.remove.distributing = Раунд {0}: зображення ще розподіляються. Вилучіть файли з конфліктом інтересів після завершення.
coi.disqualified = Раунд {1}: дискваліфіковано {0} файлів з конфліктом інтересів; їх оцінки збережено.
coi.disqualify.open = Раунд {0} відкритий для журі: подальші розподіли не включатимуть {1} файлів з конфліктом інтересів. Щоб дискваліфікувати їх, зупиніть раунд, а тоді скористайтеся сторінкою конфлікту інтересів раунду:
coi.disqualify.frozen = Раунд {0}: розподіл наступного раунду читає його оцінки. Спробуйте після завершення.
coi.action.open = Раунд {0} відкритий для журі: спершу зупиніть його, щоб дискваліфікувати чи повторно допустити файли.
coi.requalified = Раунд {1}: повторно допущено {0} файлів разом з оцінками.
coi.none.selected = Не вибрано жодного файлу.
coi.too.many.selected = Вибрано понад {0,number,#} файлів: виберіть не більше {0,number,#} і повторіть для решти.
coi.requalify.reason.missing = Виберіть, чому файли допускаються повторно.
coi.round.link = Конфлікт інтересів у цьому раунді
coi.round.title = Конфлікт інтересів
coi.round.title.of = Конфлікт інтересів у раунді {0} {1}
coi.round.help = Файли раунду, автор яких — учасник конкурсу в ролі з конфліктом інтересів або root. Дискваліфікація вилучає файл зі списків журі та результатів, зберігаючи оцінки; повторний допуск повертає їх. Обидві дії — лише коли раунд зупинено.
coi.role.help = Члени журі, організатори та адміністратори: їхні власні фотографії (за їхнім вікі-обліковим записом) теж мають конфлікт інтересів. Правління, Ревізійна комісія та Працівники не дають доступу; вони лише позначають фотографії людини як такі, що мають конфлікт інтересів.
coi.round.matches = Конфлікт інтересів у раунді
coi.round.matches.none = Зараз жоден файл раунду не має конфлікту інтересів.
coi.round.disqualified = Дискваліфіковані файли
coi.round.disqualified.none = У цьому раунді немає дискваліфікованих файлів.
coi.round.back = Назад до раунду
coi.select = Вибрати
coi.file = Файл
coi.person = Чий
coi.reason = Причина
coi.disqualified.at = Дискваліфіковано
coi.match.now = Зараз
coi.match.ended = Конфлікту інтересів більше немає
coi.match.still = Конфлікт інтересів досі є: {0}
coi.disqualify = Дискваліфікувати вибрані файли
coi.disqualify.help = Їх оцінки зберігаються окремо; «Розподілити нові файли» їх більше не додає. Це не змінює налаштування раунду «Не включати файли з конфліктом інтересів»: подальші розподіли не включатимуть нові збіги, лише якщо його позначено.
coi.requalify = Повторно допустити вибрані файли
coi.requalify.help = Їх оцінки повертаються такими, як були. Файл, що досі має конфлікт інтересів, знову пропонується до дискваліфікації.
coi.requalify.reason = Чому
coi.requalify.reason.mistaken_match = Помилковий збіг
coi.requalify.reason.conflict_ended = Конфлікт інтересів закінчився
coi.code.coi = Конфлікт інтересів
coi.code.min_mpx = Замало мегапікселів
coi.code.category = Категорія
coi.code.date = Дата
coi.code.manual = Вилучено вручну
coi.history = Історія
coi.history.help = Усі дискваліфікації та повторні допуски файлів раунду, відколи ведеться ця історія, від найновіших.
coi.history.none = Жоден файл цього раунду не було дискваліфіковано чи повторно допущено, відколи ведеться ця історія.
coi.history.limited = Показано лише останні {0}.
coi.history.at = Коли
coi.history.action = Що
coi.history.status = Статус
coi.history.by = Хто
coi.event.disqualify = Дискваліфіковано
coi.event.requalify = Повторно допущено
coi.status.in = У раунді
