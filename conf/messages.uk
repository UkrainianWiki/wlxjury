error.api.token.limit = У вас уже {0} дійсних токенів, це найбільше дозволене. Відкличте один, щоб створити новий.

# облікові записи: запрошення, посилання для пароля, зміна адреси, встановлення (безпековий пакет S2)
not.a.member.invitation = Ще немає облікового запису? Облікові записи створюють адміністратори конкурсу, які надсилають вам запрошення електронною поштою.
signin.password.link.hint = Забули пароль або давно не входили? Старі паролі застарівають: попросіть адміністратора вашого конкурсу надіслати посилання для встановлення нового.
password.retired = пароль застарів
password.retired.hint = Старий пароль облікового запису застарів, так і не використаний: надішліть запрошення, щоб встановити новий.
setup.needed = У цьому встановленні ще немає облікових записів. Адміністратор створює перший на сторінці встановлення (див. посібник із розгортання).
account.link.invalid.title = Цим посиланням не можна скористатися
account.link.invalid = Посилання недійсне, застаріло або вже використане. Попросіть адміністратора вашого конкурсу надіслати нове.
invitation.title = Встановіть пароль
invitation.reset.title = Встановіть новий пароль
invitation.set.password = Виберіть пароль для входу до WLX Jury. Ваша адреса електронної пошти — ваш логін.
invitation.replaces.password = Виберіть новий пароль. Він замінить старий пароль цього облікового запису і завершить усі інші його сеанси.
invitation.submit = Зберегти пароль і увійти
new.password = Новий пароль
current.password = Поточний пароль
current.password.explain = Потрібен, щоб змінити пароль або адресу електронної пошти.
passwords.differ = Паролі не збігаються.
password.current.wrong = Поточний пароль неправильний.
password.others.not.allowed = Пароль цього облікового запису не можна встановити: його видалено або він не бере участі в цьому конкурсі.
password.set.by.admin = Встановити пароль
password.set.by.admin.help = Залиште порожнім, щоб зберегти поточний пароль. Новий пароль завершить усі сеанси людини, а її email потрібно буде підтвердити знову. Передайте пароль особисто.
password.set.by.admin.done = Пароль встановлено. Усі сеанси людини завершено, а її email потрібно буде підтвердити знову.
password.set.email.separately = Змініть email і встановіть пароль окремими збереженнями.
password.set.role.separately = Змініть роль і встановіть пароль окремими збереженнями.
password.set.no.login = Для цього облікового запису не можна встановити пароль: у нього немає адреси email, тому він входить через Wikimedia, або йому нічим увійти.
password.set.others.saved = Інші зміни збережено; пароль не встановлено.
email.change.title = Нова адреса електронної пошти
email.change.confirm = Зробити {0} адресою вашого облікового запису в WLX Jury?
email.change.confirm.button = Підтвердити нову адресу
email.change.done = Ваша адреса електронної пошти тепер {0}. Увійдіть із нею.
email.change.explain = Нова адреса набуде чинності, коли ви перейдете за посиланням, надісланим на неї.
email.change.sent = Посилання для підтвердження надіслано на нову адресу. Вона набуде чинності після переходу за ним.
email.change.subject = Підтвердіть нову адресу електронної пошти для WLX Jury
email.change.body = Вітаємо!\n\nНа сторінці свого профілю в WLX Jury ({2}), інструменті журі фотоконкурсів Wiki Loves, ви попросили зробити цю адресу адресою електронної пошти вашого облікового запису.\n\nПерейдіть за цим посиланням протягом {1} год., щоб це підтвердити:\n{0}\n\nЯкщо ви цього не просили, проігноруйте лист: ваш обліковий запис збереже поточну адресу.
setup.title = Встановлення WLX Jury
setup.explain = Створіть перший обліковий запис, адміністратора (root), за допомогою токена встановлення з конфігурації сервера.
setup.token = Токен встановлення
setup.submit = Створити обліковий запис
setup.token.invalid = Токен встановлення неправильний.
invitation.subject = Запрошення до журі {0}
invitation.body = Вітаємо!\n\n{1} запрошує вас до журі {0}.\nПерейдіть за цим посиланням протягом {3} дн., щоб встановити пароль і увійти:\n{2}\n\nВаша адреса електронної пошти — ваш логін.
invitation.subject.tool = Запрошення до WLX Jury
invitation.body.tool = Вітаємо!\n\n{2} запрошує вас до WLX Jury, інструменту журі фотоконкурсів Wiki Loves.\nПерейдіть за цим посиланням протягом {1} дн., щоб встановити пароль і увійти:\n{0}\n\nВаша адреса електронної пошти — ваш логін.
invitation.link = Перейдіть за цим посиланням протягом {1} дн., щоб встановити пароль і увійти:\n{0}
password.link.subject = Встановіть новий пароль для WLX Jury
password.link.body = Вітаємо!\n\nПерейдіть за цим посиланням протягом {1} дн., щоб встановити новий пароль для WLX Jury:\n{0}\n\nДо того часу діє поточний пароль. Якщо ви цього не очікували, проігноруйте лист.
password.link.sent = Посилання для встановлення нового пароля надіслано на адресу облікового запису. Поточний пароль діє, доки ним не скористаються.
password.link.not.sent = Не вдалося надіслати посилання. Спробуйте пізніше.
password.link.no.email = Обліковий запис не має адреси електронної пошти, тож посилання не можна надіслати.
wiki.account.invalid = Це недійсне ім''я користувача вікі.
wiki.account.taken = Цей вікі-обліковий запис уже має інший обліковий запис.
wiki.account.own.readonly = Ваш вікі-обліковий запис поки не можна змінити тут; зверніться до адміністратора вашого конкурсу.
wiki.account.unverified.hint = Не перевірено: будь-хто міг ввести цей вікі-обліковий запис.
email.unverified.hint = Жодне запрошення чи посилання, надіслане на цю адресу, ще не використано. Щоб надати цьому обліковому запису нову роль, надішліть запрошення.
email.unverified.own.hint = Вашу адресу ще не підтверджено: попросіть адміністратора вашого конкурсу надіслати вам запрошення електронною поштою.
unverified = не перевірено
role.needs.invitation.email = Цей обліковий запис не підтвердив адресу і не має адреси для запрошення: роль не можна надати.
invitation.send = Надіслати запрошення ще раз
invitation.sent = Запрошення надіслано. Роль діятиме після того, як його приймуть.
invitation.not.sent = Не вдалося надіслати запрошення. Спробуйте пізніше.
invitation.not.possible = Цьому обліковому запису не можна надіслати запрошення.
invitations.pending = Ще не прийняті запрошення
invitation.expires = Діє до
users.invited = Запрошено (роль надається після прийняття запрошення): {0}.
users.not.added.wiki.unverified = Не додано, бо вікі-обліковий запис належить обліковому запису, що його не підтвердив: {0}. Додайте їх за електронною поштою.
users.invitations.not.sent = Запрошень, які не вдалося надіслати: {0}.
invitation.password.placeholder = той, який ви виберете за посиланням нижче
invitation.cancel = Скасувати
invitation.cancelled = Запрошення скасовано.
invitation.set.password.wiki = Виберіть пароль для входу до WLX Jury. Ваш вікі-обліковий запис, {0}, — ваш логін.
invitations.recent = Запрошення
share.link.create = Створити посилання, щоб передати
share.link.title = Посилання для встановлення пароля
share.link.for = Для: {0}
share.link.invitation.help = Скопіюйте це посилання й надішліть його людині самі. Воно один раз встановлює пароль облікового запису й виконує вхід; тоді ж починає діяти роль.
share.link.reset.help = Скопіюйте це посилання й надішліть його людині самі. Воно один раз встановлює новий пароль облікового запису й завершує всі інші його сеанси. Доти діє поточний пароль.
share.link.reset.explain = Посилання, що встановлює новий пароль, яке ви надсилаєте людині самі, а не поштою. Нове посилання скасовує попередні невикористані.
share.link.expires = Діє до {0}.
share.link.warning = Будь-хто, хто має це посилання, може встановити пароль цього облікового запису: надсилайте його лише цій людині, особисто.
share.link.once = Це посилання показано лише зараз. Якщо оновити чи повторно надіслати цю сторінку, буде створено нове посилання, а це перестане діяти; так само діє будь-яке нове посилання, поштою чи щоб передати. Його створення скасувало попередні невикористані посилання того ж виду, зокрема надіслані поштою (і скидання пароля root).
share.link.copy = Копіювати
share.link.copied = Скопійовано
share.link.back = Назад
share.link.no.login = Обліковий запис не має ні адреси електронної пошти, ні вікі-облікового запису для входу, тому посилання створити не можна.
share.link.wikimedia = Обліковий запис не має адреси електронної пошти: людина входить через Wikimedia, зі своїм вікі-обліковим записом, тому посилання для пароля не створюється.
share.link.wikimedia.note = Входить через Wikimedia як {0}
links.title = Посилання для встановлення пароля
link.purpose = Посилання
link.purpose.invitation = Запрошення
link.purpose.password_reset = Новий пароль
link.created = Створено
link.sent = Передано
link.sent.mail = Поштою
link.sent.shared = Посиланням
link.status = Стан
link.status.active = діє
link.status.active.at = до {0}
link.status.used = використано
link.status.used.at = {0}
link.status.expired = закінчилося
link.status.expired.at = {0}
link.status.revoked = скасовано
link.status.revoked.at = {0}
root.needs.verified.email = Root можна надати лише обліковому запису, власник якого підтвердив адресу (прийняте запрошення або посилання для пароля). Спершу надішліть йому посилання для пароля.
root.flag = Root (усі конкурси)
root.new.account = Новий обліковий запис не можна зробити root. Додайте людину; коли вона прийме запрошення, позначте Root на сторінці редагування її облікового запису.
root.own.unchanged = Не можна змінити Root для власного облікового запису. Це може зробити інший root.
root.set.email.separately = Змініть Root і email окремими збереженнями.
root.changed.meanwhile = Root тим часом змінили. Перезавантажте сторінку й спробуйте знову.
email.changed.subject = Адресу електронної пошти вашого облікового запису в WLX Jury змінено
email.changed.body = Вітаємо!\n\nАдресу електронної пошти вашого облікового запису в WLX Jury змінено на {0}.\n\nЯкщо це були не ви, негайно зверніться до адміністратора вашого конкурсу.

# Sessions (security batch S3)
signin.keep = Запам''ятати мене
sessions.title = Сеанси
sessions.help = Вийти на всіх пристроях і в усіх браузерах, де ви ввійшли, включно з цим. Зміна пароля теж це робить, окрім цього браузера.
sessions.help.tokens = Ваших API-токенів це не стосується: відкличте їх у розділі API-токенів.
sessions.signout.everywhere = Вийти всюди
sessions.end = Завершити сеанси
sessions.ended = Усі сеанси цього облікового запису завершено; потрібно ввійти знову.
api.tokens.revoke.all.mine = Відкликати всі токени
api.tokens.revoked.all = Відкликано токенів: {0}.

# criteria rounds (C2): the round form, the catalogue, and the shipped criteria (V83)
criteria = Критерії
criteria.help = Для раунду з оцінками: від {0} до {1} критеріїв із каталогу, у їхньому порядку, кожен оцінюється зірками раунду. Файл оцінено, коли оцінено всі його критерії, сумою їхніх оцінок. Без критеріїв: раунд без критеріїв. Після першого голосу критерій можна лише замінити на його місці.
criteria.catalogue = Каталог критеріїв
criteria.catalogue.help = Критерії, які пропонують форми раундів усіх конкурсів. Доданий тут критерій має свій текст усіма мовами, доки його не перекладено. Критерії тут не змінюються і не видаляються.
criteria.catalogue.added = Критерій додано.
criteria.catalogue.full = Каталог заповнено.
criteria.catalogue.exists = Критерій із такою назвою вже є.
criteria.position = Критерій {0}
criteria.name = Назва
criteria.fallback.name = Текст без перекладу
criteria.add = Додати критерій
criteria.add.name = Новий критерій
criteria.add.help = Його назва, до 255 символів.
criteria.overall = Загалом, на критерій
criteria.sum = сума критеріїв
criteria.rate.one = {0} (Σ {1})
criteria.rate.many = {0} (Σ {1}: {2})
criteria.rate.sum = {0} (Σ {1}, сума від {2} членів журі)
average.rate = {0} ({1})
average.sum = {0} (сума від {1} членів журі)
average.denominator.jurors = {0} / {1} членів журі
average.denominator.rated = {0} / {1} з {2} членів журі
average.denominator.sum = сума від {0} членів журі
round.average.rule = Оцінка файла
round.average.rule.rated = Середня за членами журі, які його оцінили
round.average.rule.assigned = Середня за всіма призначеними членами журі (без оцінки — 0)
round.average.rule.sum = Сума оцінок (пропущений членом журі файл нічого не отримує)
round.average.rule.help = Як раунд з оцінками рахує оцінку файла в результатах, рейтингах і для мінімуму наступного раунду: середня за членами журі, які його оцінили; середня за всіма його членами журі, відсутня оцінка як 0; або сума оцінок. Можна змінити будь-коли; уже розподілений наступний раунд зберігає взяті файли.
round.average.rule.of = Оцінка файла: {0}
round.average.rule.change.warning = Збереження іншого правила оцінки одразу перераховує і перевпорядковує результати цього раунду на всіх сторінках: у фоні нічого не перераховується. Розподіл, уже поставлений у чергу або запущений, зберігає правило, з яким почався.
round.average.rule.change.later = {1,choice,1#Раунд {0} узяв свої файли за оцінками цього раунду; ці файли залишаються. Відтепер розподіл нових файлів у ньому застосовує нове правило.|1<Раунди {0} узяли свої файли за оцінками цього раунду; ці файли залишаються. Відтепер розподіл нових файлів у них застосовує нове правило.}
average.file.rating.sum = Для раунду, оціненого сумою оцінок: мінімальна оцінка, сума (наприклад, до 50 для 10 членів журі по 5 зірок).
average.file.rating.criteria.sum = Для раунду з критеріями: сума оцінок критеріїв, середня за членами журі (наприклад, до 40 для 4 критеріїв по 10 зірок, без половинок зірок).
error.criteria.rated.only = Критерії є лише в раундах з оцінками.
error.criteria.count = Виберіть від {0} до {1} критеріїв або жодного.
error.criteria.distinct = Виберіть кожен критерій лише раз.
error.criteria.unknown = Виберіть критерії з каталогу.
error.criteria.voted = У раунді вже є голоси: його критерії можна лише замінити на їхніх місцях, не додати, не видалити і не переставити.
error.criteria.name.length = Назва задовга.
criterion.science = Науковість
criterion.caption = Підпис
criterion.usefulness = Корисність
criterion.aesthetics = Естетика
criterion.uniqueness = Унікальність
criterion.technical.quality = Технічна якість
criterion.wikipedia.usefulness = Корисність для Вікіпедії
criterion.photo.originality = Оригінальність фото
criterion.extra.points = Додаткові бали

# Sign-in with a Google or Wikimedia account (controllers.OAuthController)
oauth.signin.wikimedia = Увійти через Вікімедіа
oauth.signin.google = Увійти через Google
oauth.or = або з логіном журі
oauth.no.account = Немає облікового запису журі для цього акаунта. Попросіть адміністратора вашого конкурсу запросити вас або увійдіть з паролем і прив’яжіть акаунт на сторінці профілю.
oauth.ambiguous = Цьому акаунту відповідає кілька облікових записів журі. Зверніться до адміністратора вашого конкурсу.
oauth.failed = Не вдалося увійти. Спробуйте ще раз.
oauth.cancelled = Вхід скасовано.
oauth.linked = Акаунт прив’язано. Тепер ви можете входити з ним.
oauth.unlinked = Акаунт відв’язано, інші ваші сеанси завершено. Увійти з ним знову можна, лише прив’язавши його тут.
oauth.linked.other = Цей акаунт уже прив’язано до іншого облікового запису журі.
oauth.linked.accounts = Прив’язані акаунти
oauth.not.linked = Не прив’язано
oauth.connect = Прив’язати
oauth.unlink = Відв’язати
oauth.provider.google = Google
oauth.provider.wikimedia = Вікімедіа
oauth.unverified = Цьому акаунту відповідає ще не підтверджений обліковий запис журі. Прийміть запрошення з листа або увійдіть з паролем, потім прив’яжіть цей акаунт на сторінці профілю.
oauth.busy = Забагато входів одночасно. Спробуйте ще раз за хвилину.
oauth.linked.wiki.set = Акаунт прив’язано, і його ім’я користувача тепер ваш вікі-акаунт.
oauth.linked.wiki.taken = Акаунт прив’язано. Його ім’я користувача — вікі-акаунт іншого облікового запису журі, тому ваш не змінено: зверніться до адміністратора вашого конкурсу.
oauth.link.unverified = Вашу адресу ще не підтверджено. Попросіть адміністратора вашого конкурсу надіслати вам запрошення поштою, прийміть його, потім прив’яжіть акаунт.
oauth.wiki.other.identity = Обліковий запис журі з цим вікі-ім’ям уже був прив’язаний до акаунта Вікімедіа. Увійдіть з ним або зверніться до адміністратора вашого конкурсу.
oauth.wiki.ask.organizer = Ваш вікі-акаунт указав адміністратор вашого конкурсу: попросіть його змінити.
oauth.linked.wiki.other = Акаунт прив’язано. Його ім’я користувача не збігається з вашим вікі-акаунтом, який не змінено: попросіть адміністратора вашого конкурсу змінити його.
oauth.wiki.confirm.title = Указати вікі-акаунт
oauth.wiki.confirm.text = Використати прив’язаний акаунт Вікімедіа {0} як ваш вікі-акаунт? Його буде позначено як підтверджений.
oauth.wiki.confirm.submit = Використати
oauth.google.email.not.proof = Google не підтверджує, кому належить ця адреса (це не адреса Gmail чи Google Workspace). Спершу прийміть запрошення з листа, потім прив’яжіть Google на сторінці профілю; після цього ви зможете входити з ним.
oauth.choose.title = Виберіть обліковий запис журі
oauth.choose.text = Ваше ім’я користувача Вікімедіа вказано як вікі-акаунт у кількох облікових записах журі. Виберіть свій; для облікового запису, до якого можна увійти, потрібен його пароль або посилання, надіслане на його адресу.
oauth.choose.no.email = Без адреси
oauth.choose.no.contests = Немає конкурсів
oauth.choose.this = Це мій обліковий запис
oauth.choose.password = Його пароль
oauth.choose.with.password = Вибрати з паролем
oauth.choose.with.mail = Надіслати посилання
oauth.choose.ask.organizer = Цей обліковий запис не можна вибрати тут: зверніться до адміністратора вашого конкурсу.
oauth.choose.expired = Час вибору минув. Увійдіть через Вікімедіа ще раз.
oauth.choose.password.wrong = Неправильний пароль. Нічого не прив’язано.
oauth.choose.mail.sent = Посилання надіслано на адресу облікового запису. Відкрийте його в цьому браузері.
oauth.choose.mail.not.sent = Посилання не надіслано (його щойно надіслали, або в облікового запису немає підтвердженої адреси).
oauth.choose.proof.needed = Для цього облікового запису потрібен його пароль або посилання поштою.
oauth.choose.link.invalid = Це посилання більше не дійсне. Увійдіть через Вікімедіа ще раз.
oauth.choose.confirm.text = Підтвердьте, що цей обліковий запис журі ваш, щоб прив’язати до нього акаунт Вікімедіа й увійти.
oauth.choose.confirm = Підтвердити
oauth.choose.mail.subject = Підтвердьте обліковий запис журі
oauth.choose.mail.body = Хтось, хто входить до WLX Jury з акаунтом Вікімедіа {2}, вибрав ваш обліковий запис журі. Якщо це були ви, відкрийте це посилання в тому самому браузері протягом {1} хвилин:\n{0}\n\nЯкщо ні, проігноруйте лист: нічого не зміниться.
oauth.unlinked.before = Цей акаунт було відв’язано від облікового запису журі. Увійдіть з паролем, потім знову прив’яжіть його на сторінці профілю.
oauth.choose.too.many = Забагато неправильних паролів. Увійдіть через Вікімедіа пізніше.
round.worst.mark = Найгірша оцінка
round.worst.mark.help = Дозволяє членам журі поставити файлу найгіршу оцінку, а не залишати його без оцінки. Найгірша оцінка рахується як 0 у кожному середньому й сумі та як голос у поступі члена журі; наступний раунд може виключити файли з певною кількістю найгірших оцінок. Лише для раунду з оцінками без критеріїв.
error.worst.mark.rated.only = Найгірша оцінка можлива лише в раунді з оцінками без критеріїв.
rejected.by.help = Відхилення раунду «так/ні» або найгірші оцінки раунду з оцінками.
vote.worst = Найгірша оцінка
vote.clear = Зняти оцінку
worst.marks = Найгірших оцінок: {0}
large.rate.worst = Оцінка: найгірша

# an admin's change of another account's email, the invitation mail as a choice, the account change log (V96)
link.sent.none = Не надіслано
invitation.send.now = Надіслати запрошення
invitation.send.email = Надіслати запрошення електронною поштою
invitation.send.email.help = Якщо не позначено, лист не надсилається: надішліть його пізніше кнопкою з конвертом у списку або створіть посилання, щоб передати.
invitation.send.email.edit.help = На адресу облікового запису (нову, якщо ви її змінюєте) або для ролі, що потребує запрошення. Якщо не позначено, нічого не надсилається: натомість створіть посилання, щоб передати, або встановіть пароль.
email.change.admin.explain = Нова адреса діє одразу, непідтверджена. Людина зберігає свій пароль і входить з новою адресою; на підтверджену попередню адресу надходить коротке повідомлення.
users.invitations.not.mailed = Запрошень, не надісланих поштою (як ви обрали): {0}. Надішліть їх кнопкою з конвертом або створіть посилання, щоб передати.
invitation.created.not.sent = Роль набуде чинності, коли людина прийме запрошення. Його не надіслано поштою: надішліть його або створіть посилання, щоб передати, на сторінці користувачів.
invitation.not.mailed = Запрошення не надіслано поштою: надішліть його кнопкою з конвертом на сторінці користувачів або створіть посилання, щоб передати.
email.changed.by.admin.done = Адресу електронної пошти змінено на {0}, непідтверджену. Людину виведено з усіх сеансів.
email.changed.by.admin.password = Вона входить з новою адресою і своїм поточним паролем.
email.changed.by.admin.notified = На попередню адресу надіслано коротке повідомлення.
email.none = (немає)
email.changed.by.admin.body = Вітаємо!\n\n{1} змінює адресу електронної пошти вашого облікового запису в WLX Jury ({2}) на {0}. Тепер ви входите з новою адресою.\n\nЯкщо це помилка, зверніться до: {1}.
account.changes.title = Зміни облікових записів
account.changes.explain = Що адміністратори і root змінили в облікових записах інших людей у цьому конкурсі, найновіші першими. Тут видно адреси електронної пошти: це бачать лише адміністратори конкурсу і root.
account.changes.back = Назад до користувачів
account.changes.none = Змін поки немає.
account.changes.pages = Сторінки змін облікових записів
account.changes.newer = Новіші
account.changes.older = Старіші
account.changes.page = Сторінка {0} з {1}
account.change.when = Коли
account.change.who = Хто
account.change.account = Обліковий запис
account.change.what = Зміна
account.change.from = Було
account.change.to = Стало
account.change.mail = Лист
account.change.comment = Коментар
account.change.mail.sent = надіслано
account.change.mail.not.sent = не надіслано
account.change.comment.field = Коментар для журналу
account.change.comment.help = Необов''язково. Показується з цією зміною в розділі «Зміни облікових записів» адміністраторам конкурсу і root.
account.change.field.email = Адреса електронної пошти
account.change.field.password = Встановлено пароль
account.change.field.role = Роль
account.change.field.name = Ім''я
account.change.field.wiki_account = Вікі-обліковий запис
account.change.field.root = Root
account.change.field.account_created = Створено обліковий запис
account.change.field.invitation = Запрошення
account.change.field.invitation_cancelled = Запрошення скасовано
account.change.field.password_link = Посилання для пароля
account.change.field.share_link = Створено посилання, щоб передати
account.change.field.sessions_ended = Сеанси завершено
user.email.changed.meanwhile = Цю адресу електронної пошти тим часом змінив хтось інший. Перезавантажте сторінку і спробуйте ще раз.
users.invitations.not.possible = Облікових записів, яким не можна надіслати запрошення (їхню адресу встановив адміністратор, а ви не можете дати їм пароль; зверніться до root): {0}.
account.change.mail.notice.queued = повідомлення на попередню адресу поставлено в чергу
users.import.problems.title = Не додано
users.import.line.failed = Рядок {0}: {1}: помилка на нашому боці (код {2}).
users.import.line.invalid = Рядок {0}: {1}: це не адреса електронної пошти і не правильне ім''я облікового запису Вікімедіа.
users.import.problems.intro = Інші рядки імпортовано. Рядки, які не додано, вписано нижче, щоб імпортувати їх ще раз.
users.import.problems.correct = Виправте неправильні записи, перш ніж імпортувати їх ще раз.
users.import.problems.retry = Якщо помилка повториться, повідомте її код тим, хто обслуговує інструмент журі. Тим, кого вже видно на сторінці користувачів, достатньо надіслати запрошення звідти.
users.import.problems.lost = Не додано рядків: {0}, і їхній список уже недоступний. Перегляньте сторінку користувачів та імпортуйте ще раз тих, кого там немає.
users.import.problems.more = Не додано й не показано тут рядків: {0}. Перегляньте на сторінці користувачів, кого бракує.
account.change.mail.unknown = невідомо
