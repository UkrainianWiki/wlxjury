import.source.identity.warn = Це конкурс {0}, а джерело називає {1}. Імпортовані файли додаються до файлів, які вже є в конкурсі. Для нового конкурсу чи нового року попросіть адміністраторів інструмента створити новий конкурс. Імпортувати все одно можна.
error.wiki.title.invalid = Це не допустима назва сторінки чи категорії Вікісховища. Використайте назву на кшталт Category:Images from Wiki Loves Earth 2020 in Brazil; символи # < > [ ] | і фігурні дужки недопустимі.

