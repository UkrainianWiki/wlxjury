authors.list = Автори
authors.of = Автори конкурсу або раунду
authors.whole.contest = Увесь конкурс
authors.round.link = Автори цього раунду
authors.summary = {0}: {1}, {2}
authors.count.one = {0} автор
authors.count.few = {0} автори
authors.count.many = {0} авторів
authors.count.other = {0} автора
authors.files.count.one = {0} файл
authors.files.count.few = {0} файли
authors.files.count.many = {0} файлів
authors.files.count.other = {0} файлу
authors.largest = найбільше в одного автора: {0} ({1})
authors.without = Файлів без збереженого автора: {0}
authors.none = Для цих файлів не збережено жодного автора.
authors.worst = ✗ (найгірша оцінка)
authors.average = Середня
authors.binary.note = Кожен файл раунду враховано один раз, за голосами всіх його членів журі: схвалений (принаймні одне «так»), відкинутий усіма (голоси є, жодного «так») або ще не оцінений (жодного голосу, також файл, не призначений нікому), тож три числа дають разом файли автора, кожне з часткою від них. Частка схвалень: голоси «так» серед усіх голосів «так» і «ні» за файли автора, порівнянна за будь-якої кількості членів журі на файл; — без жодного голосу.
authors.approved = Схвалені
authors.rejected.all = Відкинуті всіма
authors.not.voted = Ще не оцінені
authors.approval.rate = Частка схвалень
authors.rated.note = Оцінені: файли з принаймні однією оцінкою. ✗: файли з принаймні однією найгіршою оцінкою. Середня: середня оцінка оцінених файлів автора в зірках, як раунд оцінює файл (за критерієм у раунді з критеріями).
