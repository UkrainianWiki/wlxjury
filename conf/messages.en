top.n.reason.tie.before = before the tie at {0} (places {1}–{2})
top.n.reason.level = all files with {0}; next: {2}, files: {1}
top.n.level.approvals = {0} yes, {1} no
top.n.level.difference = yes minus no: {0}
top.n.level.yes = {0} yes
top.n.basis.candidate = chosen from the candidate cuts: {0}
top.n.basis.list = chosen from the list
top.n.cut.score = top {0} · score ≥ {1}
top.n.cut.level = top {0} · {1}
top.n.cut.top = top {0}
top.n.cut.others = Other cuts
top.n.cut.divider = Cut: {0}
top.n.keep = The round keeps
top.n.keep.threshold = the files scoring at least the cut’s score
top.n.keep.top = the top N files
top.n.keep.help = A score can’t fall inside a tie, so the files scoring at least it are taken even if votes change later (their number may then change). The top N takes exactly N files; if votes change so that N falls inside a tie, the round’s setup stops and asks for a new N.
top.n.show.cut = Show this cut in the ratings
top.n.held.threshold = files scoring at least {0}
top.n.held.threshold.none = This round kept the files scoring at least {0}, and no file scores that now. Choose a cut or “No top N”.
top.n.held.both = This round kept both the top {0} and the files scoring at least {1} ({2} files now). A round keeps one cut now: choose it.
top.n.basis.threshold = {0} files when saved

