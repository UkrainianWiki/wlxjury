top.n.in.tie.upper = N = {0} is inside a tie (places {1}–{2}); choose {3}.
top.n.above.all = N = {0} is more than the files that can be taken ({1}); choose {1} or fewer.
top.n.reason.drop = scores drop {0} → {1}
