# Sessions (security batch S3)
signin.keep = Keep me signed in
sessions.title = Sessions
sessions.help = Sign out on every device and browser where you are signed in, this one included. Changing your password does this too, except on this browser. Your API tokens are not affected: revoke them under API tokens.
sessions.signout.everywhere = Sign out everywhere
sessions.end = End sessions
sessions.ended = Every session of this account has ended; it must sign in again.
api.tokens.revoke.all.mine = Revoke all tokens
api.tokens.revoked.all = Tokens revoked: {0}.

# criteria rounds (C2): the round form, the catalogue, and the shipped criteria (V83)
criteria = Criteria
criteria.help = For a rated round: {0} to {1} criteria from the catalogue, in their order, each rated on the round stars. A file is rated once all its criteria are, with their sum. None: a round without criteria. After the first vote a criterion can only be replaced in its place.
criteria.catalogue = Criteria catalogue
criteria.catalogue.help = The criteria the round forms of every contest offer. A criterion added here is named by its text in every language until it is translated. Criteria are not changed or removed here.
criteria.catalogue.added = Criterion added.
criteria.catalogue.full = The catalogue is full.
criteria.catalogue.exists = A criterion of this name exists.
criteria.position = Criterion {0}
criteria.name = Name
criteria.fallback.name = Text without a translation
criteria.add = Add criterion
criteria.add.name = New criterion
criteria.add.help = Its name, up to 255 characters.
criteria.overall = Overall, per criterion
criteria.sum = sum of the criteria
criteria.rate.one = {0} (Σ {1})
criteria.rate.many = {0} (Σ {1}: {2})
criteria.rate.sum = {0} (Σ {1}, sum of {2} jurors)
average.rate = {0} ({1})
average.sum = {0} (sum of {1} jurors)
average.denominator.jurors = {0} / {1} jurors
average.denominator.rated = {0} / {1} of {2} jurors
average.denominator.sum = sum of {0} jurors
round.average.rule = File score
round.average.rule.rated = Average over the jurors who rated it
round.average.rule.assigned = Average over its assigned jurors (unrated counts as 0)
round.average.rule.sum = Total of the rates (a file a juror skipped adds nothing)
round.average.rule.help = How a rated round scores a file in its results, its rankings and a next round''s top files and minimum: the average over the jurors who rated it; the average over all its jurors, a missing rate counted as 0; or the total of the rates. Can be changed at any time; a next round already distributed keeps the files it took.
round.average.rule.of = File score: {0}
average.file.rating.sum = From a round scored by the total of the rates: a minimum score, the total (e.g. up to 50 for 10 jurors of 5 stars).
average.file.rating.criteria.sum = From a round with criteria: a sum of the criteria rates, averaged over the jurors (e.g. up to 40 for 4 criteria of 10 stars, without half stars).
error.criteria.rated.only = Criteria are for rated rounds only.
error.criteria.count = Choose {0} to {1} criteria, or none.
error.criteria.distinct = Choose each criterion once.
error.criteria.unknown = Choose criteria from the catalogue.
error.criteria.voted = The round has votes: its criteria can only be replaced in their places, not added, removed or moved.
error.criteria.name.length = The name is too long.
criterion.science = Scientific value
criterion.caption = Caption
criterion.usefulness = Usefulness
criterion.aesthetics = Aesthetics
criterion.uniqueness = Uniqueness
criterion.technical.quality = Technical quality
criterion.wikipedia.usefulness = Usefulness for Wikipedia
criterion.photo.originality = Originality of the photo
criterion.extra.points = Extra points

# Sign-in with a Google or Wikimedia account (controllers.OAuthController)
oauth.signin.wikimedia = Sign in with Wikimedia
oauth.signin.google = Sign in with Google
oauth.or = or with your jury login
oauth.no.account = No jury account matches this account. Ask your contest organizer to invite you, or sign in with your password and link it on your profile page.
oauth.ambiguous = Several jury accounts match this account. Ask your contest organizer for help.
oauth.failed = Sign-in failed. Please try again.
oauth.cancelled = Sign-in was cancelled.
oauth.linked = The account is linked. You can now sign in with it.
oauth.unlinked = The account is unlinked, and your other sessions were signed out. It signs in again only once you link it here.
oauth.linked.other = This account is already linked to another jury account.
oauth.linked.accounts = Linked accounts
oauth.not.linked = Not linked
oauth.connect = Link
oauth.unlink = Unlink
oauth.provider.google = Google
oauth.provider.wikimedia = Wikimedia
oauth.unverified = This account matches a jury account that is not confirmed yet. Accept the invitation mailed to you, or sign in with your password, then link this account on your profile page.
oauth.busy = Too many sign-ins at once. Please try again in a moment.
oauth.linked.wiki.set = The account is linked, and its username is now your wiki account.
oauth.linked.wiki.taken = The account is linked. Its username is another jury account’s wiki account, so yours is unchanged: ask your contest organizer.
oauth.link.unverified = Your email is not confirmed yet. Accept the invitation mailed to you first, then link the account.
oauth.wiki.other.identity = The jury account with this wiki name was linked to a Wikimedia account before. Sign in with that one, or ask your contest organizer.
oauth.wiki.ask.organizer = Your wiki account was set by your contest organizer: ask them to change it.
oauth.linked.wiki.other = The account is linked. Its username is not your wiki account, which stays as it is: ask your contest organizer to change it.
oauth.wiki.confirm.title = Set your wiki account
oauth.wiki.confirm.text = Use the linked Wikimedia account {0} as your wiki account? It is then marked confirmed.
oauth.wiki.confirm.submit = Use it
oauth.google.email.not.proof = Google does not confirm who holds this address (it is not a Gmail or Google Workspace address). Accept the invitation mailed to you first, then link Google on your profile page; after that you can sign in with it.
oauth.choose.title = Choose your jury account
oauth.choose.text = Several jury accounts have your Wikimedia username as their wiki account. Choose yours; an account you can sign in to needs its password or a link mailed to its address.
oauth.choose.no.email = No email
oauth.choose.no.contests = No contests
oauth.choose.this = This is my account
oauth.choose.password = Its password
oauth.choose.with.password = Choose with its password
oauth.choose.with.mail = Mail me a link
oauth.choose.ask.organizer = This account cannot be chosen here: ask your contest organizer.
oauth.choose.expired = This choice has expired. Sign in with Wikimedia again.
oauth.choose.password.wrong = Wrong password. Nothing was linked.
oauth.choose.mail.sent = A link was mailed to the account’s address. Open it in this browser.
oauth.choose.mail.not.sent = No link was sent (one was sent a moment ago, or the account has no confirmed address).
oauth.choose.proof.needed = This account needs its password or a mailed link.
oauth.choose.link.invalid = This link is not valid any more. Sign in with Wikimedia again.
oauth.choose.confirm.text = Confirm that this jury account is yours, to link your Wikimedia account to it and sign in.
oauth.choose.confirm = Confirm
oauth.choose.mail.subject = Confirm your jury account
oauth.choose.mail.body = Someone signing in to the jury tool with the Wikimedia account {2} chose your jury account. If it was you, open this link in the same browser within {1} minutes:\n{0}\n\nIf it was not you, ignore this message: nothing changes.
oauth.unlinked.before = This account was unlinked from its jury account. Sign in with your password, then link it again on your profile page.
oauth.choose.too.many = Too many wrong passwords. Sign in with Wikimedia again later.
