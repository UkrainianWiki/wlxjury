# the notice to an account's owner when an admin adds it from search (accounts plan A-1, M1)
account.added.notice.subject = You were added to {0}
account.added.notice.body = Hello,\n\nThe admins of {0} added your account in the WLX Jury Tool to this contest, with the role {1}. {2}\n\nAdded by {3}. If you have questions, write to the contest''s admins or organizers. If you don''t take part in this contest, you can ignore this message: nothing else in your account has changed.\n\n{4}
