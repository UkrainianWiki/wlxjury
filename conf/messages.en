# the duplicates report (the account join plan's J-1)
duplicates.title = Possible duplicate accounts
duplicates.link = Possible duplicates
duplicates.explain = Accounts that share a wiki account (in any letter case, written as wiki names are). They may be one person''s: an account from another year or contest, or a typo. This page changes no account.
duplicates.explain.email = For root, also accounts that share a verified email address: one account''s proven address on another account''s Google or Wikimedia sign-in.
duplicates.keep.explain = If they are different people, or one person keeps several accounts on purpose (a screening round may give someone several juror accounts), press Keep separate: the pair is not listed again, for you or anyone else. Nothing is mailed.
duplicates.none = No possible duplicates.
duplicates.summary = Groups: {0}. Accounts in them: {1}.
duplicates.same.wiki = Same wiki account: {0}
duplicates.same.email = Same email address: {0}
duplicates.accounts = accounts: {0}
