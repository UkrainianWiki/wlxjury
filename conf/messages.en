# accounts: invitations, password links, email changes, setup (security batch S2)
not.a.member.invitation = No account yet? Accounts are created by contest admins, who send you an invitation by email.
signin.password.link.hint = Forgot your password, or haven''t signed in for a long time? Old passwords expire: ask your contest admin for a link to set a new one.
password.retired = password expired
password.retired.hint = The account''s old password expired unused: send an invitation to set a new one.
