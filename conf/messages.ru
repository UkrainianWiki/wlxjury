api.token.expiry.90 = 90 дней
api.token.expiry.365 = 1 год
api.token.expiry.never = Бессрочно
api.token.state = Состояние
api.token.state.revoked = Отозван
api.token.state.expired = Истёк
api.token.revoke = Отозвать
api.token.revoked = Токен отозван.
