# Install as root:root 0600. This is a systemd EnvironmentFile, not shell code.
# init-runtime can move literal credentials from the old config on the server.
WLXJURY_DB_HOST="localhost"
WLXJURY_DB="wlxjury"
WLXJURY_DB_USER="REPLACE_ME"
WLXJURY_DB_PASSWORD="REPLACE_ME"
PLAY_HTTP_SECRET_KEY="REPLACE_ME_WITH_THE_EXISTING_SIGNING_KEY"
# Every host name Apache serves the jury tool at (each vhost's ServerName), comma-separated,
# without :80 or :443.
# Required: the app refuses to start without one, and answers 400 to a Host not listed.
WLXJURY_ALLOWED_HOSTS="jury.example.org,jury.example.net"
# Omit optional Commons variables when unused. When set, the import jobs log in with
# them: a bot password (Special:BotPasswords, with "High-volume (bot) access") of a
# Commons account in the bot group, not the account's main password. The user is
# "Account@botname". A refused login is retried only after 6 hours.
# COMMONS_USER="Account@botname"
# COMMONS_PASSWORD="..."
# Omit the sign-in provider variables unless production.conf uses them (docs/oauth.md).
# WLXJURY_GOOGLE_CLIENT_ID="..."
# WLXJURY_GOOGLE_CLIENT_SECRET="..."
# WLXJURY_WIKIMEDIA_WLE_CLIENT_ID="..."
# WLXJURY_WIKIMEDIA_WLE_CLIENT_SECRET="..."
