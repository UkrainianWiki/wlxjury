<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%date [%level] %logger{36} - %message%n%xException</pattern></encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/var/log/wlxjury/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>/var/log/wlxjury/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>%date [%level] %logger{36} - %message%n%xException</pattern></encoder>
    </appender>
    <logger name="application" level="INFO"/>
    <!-- conflicts of interest removed from rounds (db.scalikejdbc.RoundConflicts): kept nowhere else -->
    <logger name="coi" level="INFO"/>
    <!-- refused personal API tokens (services.ApiTokenService): unknown ones at INFO, by prefix -->
    <logger name="services.ApiTokenService" level="INFO"/>
    <!-- a request for another host (AllowedHostsFilter): ErrorHandler logs it once as client_error;
         the filter's own WARN would double every scanner's request -->
    <logger name="play.filters.hosts.AllowedHostsFilter" level="ERROR"/>
    <!-- a refused CSRF token: CsrfErrorHandler logs it once as csrf_failure (with a reference and
         the path only); Play's own WARN would double every bot's token-less POST and quote the URI -->
    <logger name="play.filters.CSRF" level="ERROR"/>
    <!-- the MariaDB driver logs every server error at WARN with its message, bound values
         included (e.g. "Duplicate entry '<email>'"); the app logs failures itself without them
         (db.scalikejdbc.SqlLogging, ErrorHandler) -->
    <logger name="org.mariadb.jdbc" level="ERROR"/>
    <root level="WARN"><appender-ref ref="STDOUT"/><appender-ref ref="FILE"/></root>
</configuration>
