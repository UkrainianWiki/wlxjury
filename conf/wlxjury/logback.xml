<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%date [%level] %logger{36} - %message%n%xException</pattern></encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/var/log/wlxjury/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>/var/log/wlxjury/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>%date [%level] %logger{36} - %message%n%xException</pattern></encoder>
    </appender>
    <logger name="application" level="INFO"/>
    <root level="WARN"><appender-ref ref="STDOUT"/><appender-ref ref="FILE"/></root>
</configuration>
