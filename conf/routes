POST        /comment/region/:region/pageid/:pageid                                  controllers.ImageDiscussionController.addComment(pageid: Long, region: String, round: Option[Long] ?= None, contestId: Option[Long] ?= None)

POST        /rate/round/:round/pageid/:pageId/select/:select                        controllers.GalleryController.selectWS(round: Long, pageId: Long, select: Int)
GET         /large/user/:user/pageid/:pageid                                        controllers.LargeViewController.large(user: Long, pageid: Long, region: String = "all", round: Long = 0)
GET         /large/user/:user/region/:region/pageid/:pageid                         controllers.LargeViewController.large(user: Long, pageid: Long, region: String, round: Long = 0)
GET         /large/round/:round/user/:user/pageid/:pageid                           controllers.LargeViewController.large(user: Long, pageid: Long, region: String = "all", round: Long)
GET         /large/round/:round/user/:user/region/:region/pageid/:pageid            controllers.LargeViewController.large(user: Long, pageid: Long, region: String, round:Long)
POST        /large/round/:round/pageid/:pageId/select/:select                       controllers.LargeViewController.rateByPageId(round: Long, pageId: Long, select: Int, region: String = "all", criteria: Option[Long] ?= None)
POST        /large/round/:round/region/:region/pageid/:pageId/select/:select        controllers.LargeViewController.rateByPageId(round: Long, pageId: Long, select: Int, region: String, criteria: Option[Long] ?= None)
GET         /large/pageid/:pageid                                                   controllers.LargeViewController.largeCurrentUser(pageid: Long, region: String = "all")
GET         /large/region/:region/pageid/:pageid                                    controllers.LargeViewController.largeCurrentUser(pageid: Long, region: String)

GET         /admin/users                                                            @controllers.UserController.users(contestId: Option[Long] ?= None)
GET         /admin/allUsers                                                         @controllers.UserController.allUsers()
GET         /admin/importusers                                                      @controllers.UserController.showImportUsers(contestId: Option[Long] ?= None)
POST        /admin/importusers                                                      @controllers.UserController.importUsers(contestId: Option[Long] ?= None)
GET         /admin/greeting                                                         @controllers.UserController.editGreeting(contestId: Option[Long] ?= None)
POST        /admin/greeting                                                         @controllers.UserController.saveGreeting(contestId: Option[Long] ?= None)
GET         /users/edit/:id                                                         @controllers.UserController.editUser(id: Long, contestId: Option[Long] ?= None)
POST        /users/save                                                             @controllers.UserController.saveUser()
# root: mails the account a link that sets a new password (P7)
POST        /users/resetpasswd/:id                                                  @controllers.UserController.resetPassword(id: Long)
# root: ends every session of the account (its session version goes up)
POST        /users/:id/sessions/end                                                 @controllers.UserController.endSessions(id: Long)
# an admin of the contest: a new invitation for a member or pending invitee with an unverified email
POST        /users/:id/invite                                                       @controllers.UserController.reinvite(id: Long, contestId: Long)
POST        /users/:id/invitation/cancel                                            @controllers.UserController.cancelInvitation(id: Long, contestId: Long)
# the own profile's personal API tokens (POST forms with the CSRF token; the session only)
POST        /users/tokens                                                           @controllers.UserController.createApiToken()
POST        /users/tokens/revoke-all                                                @controllers.UserController.revokeAllApiTokens()
POST        /users/tokens/:id/revoke                                                @controllers.UserController.revokeApiToken(id: Long)
POST        /switch-contest/:contestId                                              @controllers.UserController.switchContest(contestId: Long)
# an old link: the contest is switched by the navbar's menu (POST) only
GET         /switch-contest/:contestId                                              @controllers.UserController.switchContestLink(contestId: Long)
# the navbar's colour mode switch (light, dark, auto): the user's row and the theme cookie
POST        /theme                                                                  @controllers.UserController.setTheme()

GET         /admin/rounds                                                           @controllers.RoundController.rounds(contestId: Option[Long] ?= None)
GET         /admin/rounds/edit                                                      @controllers.RoundController.editRound(id: Option[Long] ?= None, contestId: Long, topImages: Option[Int] ?= None)
POST        /admin/rounds/save                                                      @controllers.RoundController.saveRound()
GET         /admin/criteria                                                         @controllers.CriteriaController.list(contestId: Option[Long] ?= None)
POST        /admin/criteria                                                         @controllers.CriteriaController.add(contestId: Option[Long] ?= None)
# round_image_check jobs (round images against their votes): a round's, by its contest's admins; every round's, by root
POST        /admin/rounds/:id/check-images                                          @controllers.RoundImageCheckController.checkRound(id: Long)
POST        /admin/round-images/check                                               @controllers.RoundImageCheckController.checkAll()
# a round's conflicts of interest (P1b): the page for its admins and organizers; disqualify and requalify for its admins
GET         /admin/rounds/:id/conflicts                                             @controllers.RoundConflictsController.page(id: Long)
POST        /admin/rounds/:id/conflicts/disqualify                                  @controllers.RoundConflictsController.disqualify(id: Long)
POST        /admin/rounds/:id/conflicts/requalify                                   @controllers.RoundConflictsController.requalify(id: Long)
GET         /admin/rounds/newfiles                                                  @controllers.RoundController.newFilesCount(id: Long)
GET         /admin/jobs/:id                                                         @controllers.JobController.status(id: Long)
POST        /admin/jobs/:id/cancel                                                  @controllers.JobController.cancel(id: Long)
POST        /admin/jobs/:id/retry                                                   @controllers.JobController.retry(id: Long)
# root: another user's API tokens, and revoking them
GET         /admin/users/:userId/tokens                                             @controllers.ApiTokenAdminController.tokens(userId: Long)
POST        /admin/users/:userId/tokens/revoke                                      @controllers.ApiTokenAdminController.revokeAll(userId: Long)
POST        /admin/users/:userId/tokens/:id/revoke                                  @controllers.ApiTokenAdminController.revoke(userId: Long, id: Long)
POST        /admin/setimages                                                        @controllers.RoundController.setImages(contestId: Option[Long] ?= None)
POST        /admin/setround                                                         @controllers.RoundController.setRound()
POST        /round/setrounduser                                                     @controllers.RoundController.setRoundUser()

