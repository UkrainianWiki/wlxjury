# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# The deploy tools' readiness check, at http://127.0.0.1:9000/health/ready: any Host (anyhost:
# AllowedHostsFilter skips it), since production allows only the jury's names. It answers only
# loopback clients; through Apache (X-Forwarded-For) it is a 404 (ReadinessController).
+ anyhost
GET         /health/ready                                                           controllers.ReadinessController.ready

# Home page
GET         /                                                                       @controllers.LoginController.index

GET         /wikipedia/commons/thumb/*path                                          @controllers.ImageProxyController.serve(path: String)

# Map static resources from the /public folder to the /assets URL path; a fingerprinted name
# (<md5>-<name>, from sbt-digest) is cached for a year, a plain name for an hour
GET         /assets/*file                                                           @controllers.Assets.versioned(path="/public", file: Asset)

GET         /logout                                                                 @controllers.LoginController.logoutPage(returnTo: Option[String] ?= None)
POST        /logout                                                                 @controllers.LoginController.logout()
# every session of the account, this one included (the own profile; a POST with the CSRF token)
POST        /logout/everywhere                                                      @controllers.LoginController.logoutEverywhere()

POST        /auth                                                                   @controllers.LoginController.auth()

GET         /auth                                                                   @controllers.LoginController.login(returnTo: Option[String] ?= None)

# no sign-up: accounts come from an organizer's invitation. A mailed link (invitation, password
# link, email change) opens a page; its form posts with the CSRF token. /setup: the first account
# of an empty installation, with the configured setup token (404 otherwise)
GET         /invitation/:token                                                      @controllers.LoginController.invitation(token: String)
POST        /invitation                                                             @controllers.LoginController.acceptInvitation()
GET         /email/confirm/:token                                                   @controllers.LoginController.emailConfirmPage(token: String)
POST        /email/confirm                                                          @controllers.LoginController.emailConfirm()
GET         /setup                                                                  @controllers.LoginController.setupView()
POST        /setup                                                                  @controllers.LoginController.setup()

GET         /error                                                                  @controllers.LoginController.error(message: String ?= "Unknown error")

# Sign-in with a Google or Wikimedia account (docs/oauth.md; off without configuration). The
# starts are links (GET: a navigation to the provider) that change only the session's flow keys;
# the callback signs in or links only with that flow's state. Unlinking is a POST with the CSRF token
GET         /oauth/:provider/login                                                  @controllers.OAuthController.login(provider: String, returnTo: Option[String] ?= None)
GET         /oauth/:provider/callback                                               @controllers.OAuthController.callback(provider: String)
GET         /oauth/:provider/link                                                   @controllers.OAuthController.link(provider: String, n: Option[String] ?= None)
POST        /oauth/:provider/unlink                                                 @controllers.OAuthController.unlink(provider: String)
# the own wiki account from a linked Wikimedia account: asked on a page, set by its POST (CSRF)
GET         /oauth/wiki-account                                                     @controllers.OAuthController.wikiAccountPage(subject: String)
POST        /oauth/wiki-account                                                     @controllers.OAuthController.setWikiAccount()
# duplicates: a Wikimedia sign-in whose name several accounts have chooses one (its choice in the
# session); another than a placeholder needs its password or a link mailed to its address
GET         /oauth/choose                                                           @controllers.OAuthChooserController.page(flow: String)
POST        /oauth/choose                                                           @controllers.OAuthChooserController.choose()
GET         /oauth/choose/confirm/:token                                            @controllers.OAuthChooserController.confirmPage(token: String)
POST        /oauth/choose/confirm                                                   @controllers.OAuthChooserController.confirm()

GET         /query                                                                  controllers.GalleryController.query(module:String ?= "byrate", user: Option[Long] ?= None, page: Int ?= 1, region: String ?= "all", round: Long ?= 0)

GET         /byrate/user/:user/page/:page                                           controllers.GalleryController.byRate(user: Long, page: Int, region: String = "all", round: Long = 0)
