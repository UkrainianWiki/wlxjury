GET         /byrate/round/:round/user/:user/page/:page                              controllers.GalleryController.byRate(user: Long, page: Int, region: String = "all", round: Long)
GET         /byrate/round/:round/user/:user/region/:region/page/:page               controllers.GalleryController.byRate(user: Long, page: Int, region: String, round: Long)
GET         /byrate/round/:round/user/:user/region/:region/pageid/:pageid           controllers.GalleryController.byRateAt(user: Long, pageid: Long, region: String, round: Long)

GET         /gallery/user/:user/page/:page                                          controllers.GalleryController.list(user: Long, page: Int, region: String = "all", round: Long = 0)
GET         /gallery/user/:user/region/:region/page/:page                           controllers.GalleryController.list(user: Long, page: Int, region: String, round: Long = 0L)
GET         /gallery/round/:round/user/:user/page/:page                             controllers.GalleryController.list(user: Long, page: Int, region: String = "all", round: Long)
GET         /gallery/round/:round/user/:user/region/:region/page/:page              controllers.GalleryController.list(user: Long, page: Int, region: String, round: Long)
GET         /gallery/round/:round/user/:user/region/:region/pageid/:pageid          controllers.GalleryController.listAtId(user: Long, pageid: Long, region: String, round: Long)
GET         /regions/round/:round/user/:user/region/:region                         controllers.GalleryController.regions(user: Long, region: String, round: Long)
GET         /gallery/page/:page                                                     controllers.GalleryController.listCurrent(page: Int, region: String = "all")
GET         /gallery/region/:region/page/:page                                      controllers.GalleryController.listCurrent(page: Int, region: String)

GET         /filelist/user/:user/page/:page                                         controllers.GalleryController.fileList(user: Long, page: Int, region: String = "all", round: Long = 0, format:String ?= "wiki")
GET         /filelist/user/:user/region/:region/page/:page                          controllers.GalleryController.fileList(user: Long, page: Int, region: String, round: Long = 0, format:String ?= "wiki")
GET         /filelist/round/:round/user/:user/page/:page                            controllers.GalleryController.fileList(user: Long, page: Int, region: String = "all", round: Long, format:String ?= "wiki")
