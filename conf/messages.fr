# The contest health page (support diagnostics plan, D-1a; ContestHealth, contestHealth.scala.html)
health.title = État du concours
health.intro = Ce que montrent maintenant les données du concours, et ce qui peut poser problème. Cette page ne modifie rien.
health.summary.files = Fichiers du concours
health.summary.rounds = Tours
health.checks = Vérifications
health.outcome.pass = OK
health.outcome.info = Note
health.outcome.warn = Avertissement
health.outcome.fail = Problème
health.check.H1 = Le concours et ses sources d''import
health.check.H2 = Fichiers par pays
health.check.H4 = Imports
health.check.H5 = Noms des sources
health.check.H7 = Tours vides ou minuscules
health.check.H8 = Tours avec tous les fichiers
health.check.H9 = Tours en cours de création
health.check.H10 = Tours gelés
health.check.H12 = Tours ouverts au jury
health.h1.pass = Les sources d''import nomment le type et l''année de ce concours.
health.h1.unknown = Les sources d''import ne nomment aucun type ni aucune année de concours à comparer avec ce concours.
health.h1.warn = Sources d''import qui nomment un autre type de concours, une autre année ou un autre pays que ce concours : {0} (voir Sources d''import ci-dessous). Les fichiers importés s''ajoutent à ceux que le concours a déjà. Pour un nouveau concours ou une nouvelle année, demandez un nouveau concours aux administrateurs de l''outil.
health.h2.national = Un concours d''un seul pays : ses fichiers ne sont pas comptés par pays.
health.h2.nofiles = Le concours n''a pas encore de fichiers.
health.h2.pass = Chaque fichier est dans une des catégories de pays de ce concours.
health.h2.few = {0} fichiers sur {1} ne sont dans aucune catégorie de pays de ce concours.
health.h2.warn = {0} fichiers sur {1} ne sont dans aucune catégorie de pays de ce concours (« Images from <concours> <année> in … »). Les fichiers d''un autre concours ou d''une autre année apparaissent ici.
health.h4.none = Aucun import n''a eu lieu dans ce concours.
health.h4.pass = Les imports se sont terminés sans problème.
health.h4.failed = L''import {0} a échoué : la page des fichiers du concours en donne la raison et permet de le relancer.
health.h4.nofiles = L''import {0} n''a gardé aucun fichier : sa source n''en a donné aucun. Vérifiez le nom sur Commons. Les imports d''avant la vérification des noms lisaient un nom sans « Category: » comme une page.
health.h4.notincountries = L''import {0} a écarté {1} fichiers qui ne sont dans aucune catégorie de pays de ce concours : sa source est sans doute celle d''un autre concours ou d''une autre année.
health.h5.pass = Chaque source est une catégorie, un modèle, une page avec un espace de noms ou une liste de fichiers.
health.h5.page = L''import {0} a lu sa source, sans « Category: » devant, comme une page.
health.h5.warn = L''import {0} a lu sa source, sans « Category: » devant, comme une page, et n''a gardé aucun fichier. Si c''est une catégorie, importez de nouveau avec « Category: » devant.
health.h5.contest = La source du concours n''a pas « Category: » devant : un import la lit comme une page.
health.h7.pass = Chaque tour ouvert a des fichiers.
health.h7.empty = Le tour {0} n''a aucun fichier. Sa source et ses filtres sont sous Tours ci-dessous.
health.h7.tiny = Le tour {0} a {1} des {2} fichiers de sa source : ses filtres ont écarté presque tout.
health.h8.pass = Aucun tour ne prend tous les fichiers d''un concours qui a des fichiers d''un autre concours ou d''une autre année.
health.h8.warn = Le tour {0} prend tous les fichiers du concours, y compris ceux d''autres concours ou années.
health.h9.pass = Aucun tour n''est bloqué pendant sa création.
health.h9.slow = Le tour {0} reçoit ses fichiers depuis {1} minutes (tâche {2}).
health.h9.failed = La distribution du tour {0} (tâche {1}) a échoué ou a été annulée : ouvrez la page des tours pour la relancer.
health.h9.nojob = Le tour {0} est en cours de création, mais aucune tâche ne le remplit.
health.h10.pass = Aucun tour n''est resté gelé.
health.h10.fail = Le tour {0} est gelé sans qu''aucune tâche ne le retienne : root peut le libérer sur la page des tours.
health.h12.pass = Le jury a un tour ouvert.
health.h12.quiet = Rien ne s''est passé dans ce concours ces {0} derniers jours : non vérifié.
health.h12.noactive = Aucun tour n''est ouvert au jury : il ne voit aucun tour.
health.h12.jurorspaused = Le tour {0} est ouvert, mais aucun juré ne peut y voter : leurs votes sont suspendus, ils ne sont plus jurés du concours, ou le tour n''a aucun juré.
