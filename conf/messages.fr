# comptes : invitations, liens de mot de passe, changements d'adresse, installation (lot de sécurité S2)
not.a.member.invitation = Pas encore de compte ? Les comptes sont créés par les administrateurs du concours, qui vous envoient une invitation par courriel.
signin.password.link.hint = Mot de passe oublié, ou pas de connexion depuis longtemps ? Les anciens mots de passe expirent : demandez à l’administrateur de votre concours un lien pour en choisir un nouveau.
password.retired = mot de passe expiré
password.retired.hint = L''ancien mot de passe du compte a expiré sans être utilisé : envoyez une invitation pour en choisir un nouveau.
setup.needed = Cette installation n''a encore aucun compte. L''administrateur crée le premier sur la page d''installation (voir le guide de déploiement).
account.link.invalid.title = Ce lien ne peut pas être utilisé
account.link.invalid = Le lien n''est pas valide, a expiré ou a déjà été utilisé. Demandez à l''administrateur de votre concours de vous en envoyer un nouveau.
invitation.title = Choisissez votre mot de passe
invitation.reset.title = Choisissez un nouveau mot de passe
invitation.set.password = Choisissez un mot de passe pour vous connecter à l''outil du jury. Votre adresse courriel est votre identifiant.
invitation.replaces.password = Choisissez un nouveau mot de passe. Il remplace l''ancien mot de passe de ce compte et ferme toutes ses autres sessions.
invitation.submit = Enregistrer le mot de passe et se connecter
new.password = Nouveau mot de passe
current.password = Mot de passe actuel
current.password.explain = Nécessaire pour changer votre mot de passe ou votre adresse courriel.
passwords.differ = Les mots de passe ne correspondent pas.
password.current.wrong = Le mot de passe actuel n''est pas correct.
password.others.not.allowed = Seule la personne peut choisir son mot de passe. Root peut lui envoyer un lien pour en choisir un nouveau, et un admin ou root peut créer un lien à lui transmettre.
email.change.title = Nouvelle adresse courriel
email.change.confirm = Faire de {0} l''adresse courriel de votre compte de l''outil du jury ?
email.change.confirm.button = Confirmer la nouvelle adresse
email.change.done = Votre adresse courriel est désormais {0}. Connectez-vous avec elle.
email.change.explain = Une nouvelle adresse prend effet une fois le lien qui lui est envoyé suivi.
email.change.sent = Un lien de confirmation a été envoyé à la nouvelle adresse. Elle prend effet une fois le lien suivi.
email.change.subject = Confirmez votre nouvelle adresse courriel pour l''outil du jury
email.change.body = Suivez ce lien dans les {1} heures pour faire de cette adresse celle de votre compte de l''outil du jury :\n{0}\n\nSi vous n''avez rien demandé, ignorez ce message.
user.email.change.ask.user = L''adresse d''un compte qui a un mot de passe ne peut être changée que par son titulaire (ou par root).
setup.title = Installer l''outil du jury
setup.explain = Créez le premier compte, l''administrateur (root), avec le jeton d''installation de la configuration du serveur.
setup.token = Jeton d''installation
setup.submit = Créer le compte
setup.token.invalid = Le jeton d''installation n''est pas correct.
invitation.subject = Invitation au jury {0}
invitation.body = Bonjour,\n\n{1} vous invite au jury de {0}.\nSuivez ce lien dans les {3} jours pour choisir votre mot de passe et vous connecter :\n{2}\n\nVotre adresse courriel est votre identifiant.
invitation.subject.tool = Invitation à l''outil du jury
invitation.body.tool = Bonjour,\n\nSuivez ce lien dans les {1} jours pour choisir votre mot de passe et vous connecter à l''outil du jury :\n{0}\n\nVotre adresse courriel est votre identifiant.
invitation.link = Suivez ce lien dans les {1} jours pour choisir votre mot de passe et vous connecter :\n{0}
password.link.subject = Choisissez un nouveau mot de passe pour l''outil du jury
password.link.body = Bonjour,\n\nSuivez ce lien dans les {1} jours pour choisir un nouveau mot de passe pour l''outil du jury :\n{0}\n\nVotre mot de passe actuel fonctionne jusque-là. Si vous ne vous y attendiez pas, ignorez ce message.
password.link.sent = Un lien pour choisir un nouveau mot de passe a été envoyé au compte. Le mot de passe actuel fonctionne jusqu''à son utilisation.
password.link.not.sent = Le lien n''a pas pu être envoyé. Réessayez plus tard.
password.link.no.email = Le compte n''a pas d''adresse courriel : aucun lien ne peut être envoyé.
wiki.account.invalid = Ce n''est pas un nom d''utilisateur wiki valide.
wiki.account.taken = Un autre compte a déjà ce compte wiki.
wiki.account.own.readonly = Votre compte wiki ne peut pas encore être modifié ici ; demandez à l’administrateur de votre concours.
wiki.account.unverified.hint = Non vérifié : n''importe qui a pu saisir ce compte wiki.
email.unverified.hint = Aucune invitation ni aucun lien envoyés à cette adresse n''ont encore été utilisés. Pour donner un nouveau rôle à ce compte, envoyez une invitation.
email.unverified.own.hint = Votre adresse n''est pas encore confirmée : demandez à l''administrateur de votre concours de vous envoyer une invitation par courriel.
unverified = non vérifié
role.needs.invitation.email = Ce compte n''a pas vérifié son adresse et n''en a aucune pour l''inviter : le rôle ne peut pas être donné.
invitation.send = Renvoyer l''invitation
