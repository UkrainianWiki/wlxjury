api.tokens.revoked.all = Jetons révoqués : {0}.
api.token.scope = Accès
api.token.scope.full = Complet : lecture et écriture, depuis n''importe où
api.token.scope.local_read = Lecture seule, depuis le serveur uniquement
api.token.scope.help = Un jeton en lecture seule n''est accepté que pour lire, et seulement dans les requêtes faites sur le serveur lui-même (comme celles de l''outil wlxjury-diag par ssh), jamais via le site web. Choisissez-le pour le diagnostic.
api.token.scope.short.full = Complet
api.token.scope.short.local_read = Lecture seule, serveur uniquement
api.token.scope.short.unknown = Inconnu (refusé)
error.api.token.scope = Choisissez l''un des accès proposés.

# criteria rounds (C2): the round form, the catalogue, and the shipped criteria (V83)
criteria = Critères
criteria.help = Pour un tour noté : de {0} à {1} critères du catalogue, dans leur ordre, chacun noté avec les étoiles du tour. Un fichier est noté quand tous ses critères le sont, par leur somme ; avec un seul critère, la note du fichier est celle de ce critère. Aucun : un tour sans critères. Les critères ne peuvent pas être modifiés pendant que le tour est en cours ni une fois qu’il a des votes.
criteria.locked = Les critères du tour ne peuvent pas être modifiés pendant qu’il est en cours ni une fois qu’il a des votes.
criteria.locked.none = Il n’a pas de critères, et on ne peut plus en ajouter.
criteria.catalogue = Catalogue des critères
criteria.catalogue.help = Les critères proposés par les formulaires de tour de tous les concours. Un critère ajouté ici porte son texte dans toutes les langues tant qu’il n’est pas traduit. Les critères ne sont ni modifiés ni supprimés ici.
criteria.catalogue.added = Critère ajouté.
criteria.catalogue.full = Le catalogue est plein.
criteria.catalogue.exists = Un critère de ce nom existe.
criteria.position = Critère {0}
criteria.form.add = Ajouter des critères
criteria.form.add.another = Ajouter un autre critère
criteria.form.remove = Retirer le critère {0}
criteria.single = Note : {0}
criteria.name = Nom
criteria.fallback.name = Texte sans traduction
criteria.add = Ajouter un critère
criteria.add.name = Nouveau critère
criteria.add.help = Son nom, jusqu’à 255 caractères.
criteria.overall = Global, par critère
criteria.sum = somme des critères
criteria.rate.one = {0} (Σ {1})
criteria.rate.many = {0} (Σ {1} : {2})
criteria.rate.sum = {0} (Σ {1}, somme de {2} jurés)
average.rate = {0} ({1})
average.sum = {0} (somme de {1} jurés)
average.denominator.jurors = {0} / {1} jurés
average.denominator.rated = {0} / {1} sur {2} jurés
average.denominator.sum = somme de {0} jurés
round.average.rule = Note du fichier
round.average.rule.rated = Moyenne des jurés qui l''ont noté
round.average.rule.assigned = Moyenne de tous ses jurés (sans note : 0)
round.average.rule.sum = Total des notes (un fichier qu''un juré n''a pas noté ne reçoit rien)
round.average.rule.help = Comment un tour noté calcule la note d''un fichier dans ses résultats, ses classements et pour le minimum d''un tour suivant : la moyenne des jurés qui l''ont noté ; la moyenne de tous ses jurés, une note manquante comptant 0 ; ou le total des notes. Modifiable à tout moment ; un tour suivant déjà distribué garde les fichiers pris.
round.average.rule.of = Note du fichier : {0}
round.average.rule.change.warning = Enregistrer une autre règle de note recalcule et réordonne les résultats de ce tour sur toutes les pages, immédiatement : rien n''est recalculé en arrière-plan. Une distribution déjà en attente ou en cours garde la règle avec laquelle elle a commencé.
round.average.rule.change.later = {1,choice,1#Le tour {0} a pris ses fichiers selon les notes de ce tour ; ces fichiers restent. Désormais, distribuer de nouveaux fichiers dans ce tour applique la nouvelle règle.|1<Les tours {0} ont pris leurs fichiers selon les notes de ce tour ; ces fichiers restent. Désormais, distribuer de nouveaux fichiers dans ces tours applique la nouvelle règle.}
average.file.rating.sum = Pour un tour noté par le total des notes : une note minimale, le total (par ex. jusqu''à 50 pour 10 jurés de 5 étoiles).
average.file.rating.criteria.sum = Pour un tour avec critères : une somme des notes des critères, en moyenne sur les jurés (par ex. jusqu’à 40 pour 4 critères de 10 étoiles, sans demi-étoiles).
error.criteria.rated.only = Les critères sont réservés aux tours notés.
error.criteria.count = Choisissez de {0} à {1} critères, ou aucun.
error.criteria.distinct = Choisissez chaque critère une seule fois.
error.criteria.unknown = Choisissez les critères dans le catalogue.
error.criteria.name.length = Le nom est trop long.
criterion.science = Valeur scientifique
criterion.caption = Légende
criterion.usefulness = Utilité
criterion.aesthetics = Esthétique
criterion.uniqueness = Unicité
criterion.technical.quality = Qualité technique
criterion.wikipedia.usefulness = Utilité pour Wikipédia
criterion.photo.originality = Originalité de la photo
criterion.extra.points = Points supplémentaires

# Sign-in with a Google or Wikimedia account (controllers.OAuthController)
oauth.signin.wikimedia = Se connecter avec Wikimedia
oauth.signin.google = Se connecter avec Google
oauth.or = ou avec votre identifiant du jury
oauth.no.account = Aucun compte du jury ne correspond à ce compte. Demandez à l’administrateur de votre concours de vous inviter, ou connectez-vous avec votre mot de passe et liez-le sur votre page de profil.
oauth.ambiguous = Plusieurs comptes du jury correspondent à ce compte. Contactez l’administrateur de votre concours.
