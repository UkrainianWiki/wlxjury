# Sessions (security batch S3)
signin.keep = Rester connecté
sessions.title = Sessions
sessions.help = Se déconnecter sur tous les appareils et navigateurs où vous êtes connecté, celui-ci compris. Changer de mot de passe le fait aussi, sauf sur ce navigateur.
sessions.help.tokens = Vos jetons d''API ne sont pas concernés : révoquez-les sous Jetons d''API.
sessions.signout.everywhere = Se déconnecter partout
sessions.end = Terminer les sessions
sessions.ended = Toutes les sessions de ce compte sont terminées ; il doit se reconnecter.
