# joining accounts (the account join plan's J-2)
duplicates.join = Fusionner…
wiki.taken.join = Fusionner les deux comptes…
account.join.title = Fusionner des comptes
account.join.explain = La fusion garde un compte et retire l''autre : ses concours, ses affectations aux tours, ses votes, ses votes mis de côté et ses commentaires passent au compte gardé. Les sessions des deux comptes prennent fin, leurs jetons d''API et leurs liens non utilisés sont révoqués ; les connexions Google ou Wikimedia du compte retiré sont dissociées (leur titulaire les associe de nouveau depuis le compte gardé). C''est irréversible. Un vote des deux comptes sur le même fichier dans le même tour empêche la fusion.
account.join.back = Retour aux doublons possibles
account.join.keep.legend = Le compte à garder
account.join.keep = Garder
account.join.keep.this = Garder {0}
account.join.keep.unverified = Un autre compte a une adresse prouvée par son titulaire : gardez celui-là.
account.join.show = Voir ce que ferait la fusion
account.join.preview.title = Fusionner {0} (n° {1}) dans {2} (n° {3})
account.join.refused.intro = Cette fusion ne peut pas commencer :
account.join.refused.collisions = {0} fichiers ont un vote des deux comptes dans le même tour (liste ci-dessous). Corrigez-les d''abord à la main : une fusion ne supprime jamais de vote.
account.join.refused.kept.unverified = Le compte n° {0} a une adresse prouvée par son titulaire, celui-ci non : gardez plutôt le n° {0}.
account.join.refused.retire = Vous ne pouvez pas retirer le compte n° {0} : {1}.
account.join.refused.in.join = Le compte n° {0} est dans une autre fusion (tâche {1}). Attendez qu''elle soit finie, ou annulez-la.
account.join.refused.rebalance = Un juré est en cours d''ajout à un tour avec l''un de ces comptes (tâche {0}). Lancez la fusion une fois cet ajout terminé.
account.join.refused.distributing = Le tour {0} de ces comptes est en cours de distribution ou en revue. Terminez ou annulez d''abord la revue (ou attendez la distribution).
account.join.refused.round.job = Un tour d''un concours du compte n° {0} reçoit en ce moment ses fichiers ou un nouveau juré. Lancez la fusion une fois cela terminé.
account.join.refused.not.tied = Le compte n° {0} n''est pas membre de ce concours : lancez la fusion depuis les doublons possibles d''un concours dont il est membre.
account.join.memberships = Concours
account.join.memberships.none = Aucun des deux comptes n''est membre d''un concours.
account.join.after = Après
account.join.role.conflict = le rôle donnant le plus d''accès est gardé
account.join.rounds = Tours du compte retiré
account.join.rounds.none = Il n''a ni votes ni affectations aux tours.
account.join.round = Tour
account.join.merged = Affectations fusionnées
account.join.collisions = Collisions
account.join.round.active = juré
account.join.round.stopped = arrêté
account.join.votes = {0} fichiers, {1} votés, {2} mis de côté
account.join.round.stopped.one = arrêté dans l''un des deux
account.join.collisions.title = Votes des deux comptes sur le même fichier : {0}
account.join.collision = {0} : {1} : n° {2} {3}, n° {4} {5}
account.join.collision.aside = (mis de côté)
account.join.collisions.more = et {0} de plus
account.join.what = Ce qui change aussi
account.join.coi.leaving = Conflits d''intérêts : le compte gardé garde son compte wiki {1} ; {0} n''est plus vérifié.
account.join.coi.taken = Conflits d''intérêts : le compte gardé prend le compte wiki {0}.
account.join.coi.none = Conflits d''intérêts : aucun des deux comptes n''a de compte wiki.
account.join.coi.same = Conflits d''intérêts : pas de changement (compte wiki {0}).
account.join.coi.verified = Sa vérification suit le compte qui a prouvé ce nom.
account.join.comments = Commentaires déplacés : {0}.
account.join.identities.none = Aucune connexion Google ou Wikimedia à dissocier.
account.join.identities = Connexions dissociées, à associer de nouveau depuis le compte gardé : {0}.
account.join.sessions = Les sessions des deux comptes prennent fin ; jetons d''API révoqués : {0} ; liens non utilisés révoqués : {1}.
account.join.orphans = Ses {0} votes hors des résultats de tout tour restent au compte retiré.
account.join.retired = {0} (n° {1}) est ensuite retiré : son adresse est libérée et il ne peut plus se connecter.
account.join.notify = Prévenir les deux titulaires par courriel (adresses masquées, sans lien)
account.join.start = Fusionner le n° {0} dans le n° {1}
account.join.changed = Les comptes ont changé depuis l''ouverture de cette page. Vérifiez ce que ferait la fusion maintenant.
account.join.refused = La fusion n''a pas été lancée : voir pourquoi ci-dessous.
account.join.signin.refused = Ce compte est en cours de fusion dans un autre compte et ne peut plus être utilisé. Connectez-vous avec l''autre compte, ou demandez aux administrateurs du concours.
account.join.job.title = Fusion de {0} dans {1}
account.join.job.no.cancel = Des votes ont déjà été déplacés : la fusion ne peut plus être annulée. Si elle échoue, corrigez la cause et relancez-la.
account.join.job.done = {0} a été fusionné dans {1} et retiré.
account.join.job.votes = Votes déplacés : {0} ; votes mis de côté déplacés : {1} ; affectations non notées en double fusionnées : {2}.
account.join.job.rounds = Affectations aux tours déplacées ou fusionnées : {0} ; adhésions aux concours ajoutées ou relevées : {1} ; commentaires déplacés : {2}.
account.join.job.closed = Connexions dissociées : {0} ; jetons d''API révoqués : {1} ; liens révoqués : {2} ; sessions des deux comptes terminées.
account.join.job.mailed = Les deux titulaires ont été prévenus par courriel.
account.join.job.kept.link = Ouvrir {0}
account.join.mail.subject = Vos comptes dans l''outil du jury WLX ont été fusionnés
account.join.mail.kept = Bonjour,\n\nVotre compte dans l''outil du jury WLX et un autre compte ({0}) ont été fusionnés dans le vôtre par {1} : ses concours, tours, votes et commentaires sont maintenant dans votre compte, et l''autre compte a été retiré. Vos sessions ont pris fin : connectez-vous de nouveau.\n\nEn cas d''erreur, écrivez aux administrateurs du concours.
account.join.mail.joined = Bonjour,\n\nLe compte de cette adresse dans l''outil du jury WLX a été fusionné dans un autre compte ({0}) par {1} et retiré : cette adresse ne permet plus de se connecter. Ses concours, tours, votes et commentaires sont maintenant dans ce compte.\n\nEn cas d''erreur, écrivez aux administrateurs du concours.
account.join.mail.by.unnamed = un administrateur
job.error.join.gone = Le compte n° {0} ou n° {1} n''existe plus ou est retiré : la fusion s''est arrêtée.
job.error.join.round.busy = Le tour {0} reçoit en ce moment ses fichiers ou un nouveau juré : relancez la fusion une fois cela terminé.
job.error.join.collision = Tour {0} : {1} fichiers ont un vote des deux comptes. Corrigez-les à la main, puis relancez.
job.error.join.invariant = Tour {0} : déplacer les votes romprait la cohérence des fichiers du tour ; rien n''y a été déplacé.
job.error.join.retire.busy = Un tour d''un concours du compte n° {0} reçoit en ce moment ses fichiers ou un nouveau juré : relancez la fusion une fois cela terminé.
job.error.join.retire.refused = Le compte n° {0} n''a pas pu être retiré ({1}) : relancez une fois cela corrigé.
users.not.added.joining = Non ajoutés, le compte étant en cours de fusion avec un autre : {0}.
account.join.in.progress = Ce compte est en cours de fusion avec un autre : son rôle et son mot de passe ne peuvent pas changer avant la fin de la fusion. Rien n''a été enregistré.
job.error.join.performer = Le compte n° {0}, qui a lancé la fusion, ne peut plus fusionner ces comptes : relancez-la en tant que root ou administrateur de chaque concours des deux.
account.join.abandon = Abandonner cette fusion
account.join.abandon.help = Root seulement : arrêter définitivement cette fusion échouée. Les tours déjà déplacés restent au compte gardé, qui reçoit aussi l''adhésion de l''autre compte à leurs concours ; tout le reste reste à l''autre compte, qui n''est pas retiré. Les deux comptes peuvent de nouveau se connecter.
account.join.abandoned = Cette fusion a été abandonnée : les tours qu''elle a déplacés, et les adhésions à leurs concours, restent au compte gardé ; tout le reste reste à l''autre compte. Les deux comptes peuvent de nouveau se connecter.
account.join.abandon.not.failed = Seule une fusion échouée peut être abandonnée.
account.join.abandon.cancel.instead = Rien n''a encore été déplacé : annulez plutôt cette fusion.
account.join.merge.explain = Un fichier noté par un seul des comptes, l''autre l''ayant non noté (une affectation), garde le vote : il est fusionné, ce n''est pas une collision.
job.cancel.join.started = Cette fusion a déjà déplacé des votes et ne peut pas être annulée : relancez-la plutôt.
job.error.rebalance.joining = Le compte {0} est en cours de fusion avec un autre compte : ajoutez-le une fois la fusion terminée.
round.review.distribute.joining = Tour {0} : le compte n° {1} est en cours de fusion avec un autre compte. Choisissez de nouveau les jurés une fois la fusion terminée.
# adding by an unverified wiki account, confirmed by the admin (accounts plan A-3)
wiki.confirm.title = Confirmer le compte ayant le compte wiki {0}
wiki.confirm.intro = Rien n''a encore été ajouté. Plusieurs comptes ont le compte wiki {0}, et personne n''a vérifié qu''il est le leur : n''importe qui a pu le saisir dans son compte, ou un administrateur a pu se tromper en le tapant. Choisissez le compte de la personne que vous voulez ajouter.
wiki.confirm.intro.one = Rien n''a encore été ajouté. Un compte a le compte wiki {0}, et personne n''a vérifié qu''il est le sien : n''importe qui a pu le saisir dans son compte, ou un administrateur a pu se tromper en le tapant. Vérifiez qu''il s''agit bien de la personne que vous voulez ajouter.
wiki.confirm.typed = Vous avez saisi : {0}
wiki.confirm.risk = Le rôle ira à quiconque se connecte au compte choisi, avec son mot de passe ou son courriel, et ce n''est peut-être pas la personne que vous pensez. En cas de doute, ajoutez plutôt la personne par courriel.
wiki.confirm.accounts = Comptes ayant le compte wiki {0}
wiki.confirm.account = Le compte ayant le compte wiki {0}
wiki.confirm.no.name = (sans nom)
wiki.confirm.member = déjà dans ce concours : {0}
wiki.confirm.search.help = Seuls les noms sont affichés. Pour en savoir plus sur un compte (son courriel, masqué, et ceux de vos concours où il se trouve), cherchez-le sous « Trouver un compte existant » sur la page des utilisateurs.
wiki.confirm.role = Rôle : {0}
wiki.confirm.check = C''est bien la personne que je veux ajouter
wiki.confirm.add = Ajouter à ce concours
wiki.confirm.required = Rien n''a été ajouté : choisissez un compte et cochez « C''est bien la personne que je veux ajouter ».
wiki.confirm.done = Le compte que vous avez confirmé pour le compte wiki {0} : {1}, {2}.
wiki.confirm.placeholder.root = Il n''a ni mot de passe ni courriel : la personne ne peut se connecter qu''avec un lien créé par root.
users.not.added.wiki.confirm = Pas encore ajoutés, car le compte wiki est sur un compte qui ne l''a pas vérifié : {0}. Pour en ajouter un, saisissez son compte wiki dans la ligne d''ajout de la page des utilisateurs et confirmez le compte, ou ajoutez la personne par courriel.
users.import.wiki.confirm.link = Les confirmer sur la page des utilisateurs
