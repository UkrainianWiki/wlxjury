coi.status.removed = Hors du tour (sans votes)
coi.round.stop.help = Ses jurés ne peuvent plus voter jusqu''à ce qu''il soit redémarré depuis la liste des tours.
coi.round.stop.confirm = Arrêter le tour {0} ? Ses jurés ne pourront plus voter jusqu''à ce qu''il soit redémarré.
coi.round.stopped = Le tour {0} est arrêté : ses fichiers peuvent maintenant être disqualifiés et requalifiés.
coi.round.started = Le tour {0} est démarré.

