invitation.subject = Invitation au jury {0}
invitation.body = Bonjour,\n\n{1} vous invite au jury de {0}.\nSuivez ce lien dans les {3} jours pour choisir votre mot de passe et vous connecter :\n{2}\n\nVotre adresse courriel est votre identifiant.
invitation.subject.tool = Invitation à l''outil du jury
invitation.body.tool = Bonjour,\n\nSuivez ce lien dans les {1} jours pour choisir votre mot de passe et vous connecter à l''outil du jury :\n{0}\n\nVotre adresse courriel est votre identifiant.
invitation.link = Suivez ce lien dans les {1} jours pour choisir votre mot de passe et vous connecter :\n{0}
password.link.subject = Choisissez un nouveau mot de passe pour l''outil du jury
password.link.body = Bonjour,\n\nSuivez ce lien dans les {1} jours pour choisir un nouveau mot de passe pour l''outil du jury :\n{0}\n\nVotre mot de passe actuel fonctionne jusque-là. Si vous ne vous y attendiez pas, ignorez ce message.
password.link.sent = Un lien pour choisir un nouveau mot de passe a été envoyé au compte. Le mot de passe actuel fonctionne jusqu''à son utilisation.
password.link.not.sent = Le lien n''a pas pu être envoyé. Réessayez plus tard.
password.link.no.email = Le compte n''a pas d''adresse courriel : aucun lien ne peut être envoyé.
wiki.account.invalid = Ce n''est pas un nom d''utilisateur wiki valide.
wiki.account.taken = Un autre compte a déjà ce compte wiki.
wiki.account.own.readonly = Votre compte wiki ne peut pas encore être modifié ici ; demandez à un administrateur du concours.
wiki.account.unverified.hint = Non vérifié : n''importe qui a pu saisir ce compte wiki.
email.unverified.hint = Non vérifiée : le titulaire de cette adresse n''a pas encore accepté d''invitation. Un rôle pour ce compte attend qu''il le fasse.
unverified = non vérifié
role.needs.invitation.email = Ce compte n''a pas vérifié son adresse et n''en a aucune pour l''inviter : le rôle ne peut pas être donné.
invitation.send = Renvoyer l''invitation
invitation.sent = Une invitation a été envoyée. Le rôle s''applique une fois qu''elle est acceptée.
invitation.not.sent = L''invitation n''a pas pu être envoyée. Réessayez plus tard.
invitation.not.possible = Aucune invitation ne peut être envoyée à ce compte.
invitations.pending = Invitations pas encore acceptées
invitation.expires = Expire
users.invited = Invités (le rôle est donné une fois l''invitation acceptée) : {0}.
users.not.added.wiki.unverified = Non ajoutés, car le compte wiki appartient à un compte qui ne l''a pas vérifié : {0}. Ajoutez-les par courriel.
users.invitations.not.sent = Invitations qui n''ont pas pu être envoyées : {0}.
invitation.password.placeholder = celui que vous choisirez avec le lien ci-dessous
invitation.cancel = Annuler
invitation.cancelled = L''invitation a été annulée.
root.needs.verified.email = Root seulement pour un compte dont le titulaire a vérifié l''adresse (une invitation ou un lien de mot de passe accepté).
email.changed.subject = L''adresse courriel de votre compte de l''outil du jury a été changée
email.changed.body = Bonjour,\n\nL''adresse courriel de votre compte de l''outil du jury est désormais {0}.\n\nSi ce n''était pas vous, contactez immédiatement un organisateur du concours.

# Sessions (security batch S3)
signin.keep = Rester connecté
sessions.title = Sessions
sessions.help = Se déconnecter sur tous les appareils et navigateurs où vous êtes connecté, celui-ci compris. Changer de mot de passe le fait aussi, sauf sur ce navigateur. Vos jetons d''API ne sont pas concernés : révoquez-les sous Jetons d''API.
sessions.signout.everywhere = Se déconnecter partout
sessions.end = Terminer les sessions
sessions.ended = Toutes les sessions de ce compte sont terminées ; il doit se reconnecter.
api.tokens.revoke.all.mine = Révoquer tous les jetons
api.tokens.revoked.all = Jetons révoqués : {0}.

# criteria rounds (C2): the round form, the catalogue, and the shipped criteria (V83)
criteria = Critères
criteria.help = Pour un tour noté : de {0} à {1} critères du catalogue, dans leur ordre, chacun noté avec les étoiles du tour. Un fichier est noté quand tous ses critères le sont, par leur somme. Aucun : un tour sans critères. Après le premier vote, un critère ne peut être que remplacé à sa place.
criteria.catalogue = Catalogue des critères
criteria.catalogue.help = Les critères proposés par les formulaires de tour de tous les concours. Un critère ajouté ici porte son texte dans toutes les langues tant qu’il n’est pas traduit. Les critères ne sont ni modifiés ni supprimés ici.
criteria.catalogue.added = Critère ajouté.
criteria.catalogue.full = Le catalogue est plein.
criteria.catalogue.exists = Un critère de ce nom existe.
criteria.position = Critère {0}
criteria.name = Nom
criteria.fallback.name = Texte sans traduction
criteria.add = Ajouter un critère
criteria.add.name = Nouveau critère
criteria.add.help = Son nom, jusqu’à 255 caractères.
criteria.overall = Global, par critère
criteria.sum = somme des critères
average.file.rating.criteria.sum = Pour un tour avec critères : une somme des notes des critères, en moyenne sur les jurés (par ex. jusqu’à 40 pour 4 critères de 10 étoiles).
error.criteria.rated.only = Les critères sont réservés aux tours notés.
error.criteria.count = Choisissez de {0} à {1} critères, ou aucun.
error.criteria.distinct = Choisissez chaque critère une seule fois.
error.criteria.unknown = Choisissez les critères dans le catalogue.
error.criteria.voted = Le tour a des votes : ses critères ne peuvent être que remplacés à leur place, ni ajoutés, ni supprimés, ni déplacés.
error.criteria.name.length = Le nom est trop long.
criterion.science = Valeur scientifique
criterion.caption = Légende
criterion.usefulness = Utilité
criterion.aesthetics = Esthétique
criterion.uniqueness = Unicité
criterion.technical.quality = Qualité technique
criterion.wikipedia.usefulness = Utilité pour Wikipédia
criterion.photo.originality = Originalité de la photo
criterion.extra.points = Points supplémentaires

# Sign-in with a Google or Wikimedia account (controllers.OAuthController)
oauth.signin.wikimedia = Se connecter avec Wikimedia
oauth.signin.google = Se connecter avec Google
oauth.or = ou avec votre identifiant du jury
oauth.no.account = Aucun compte du jury ne correspond à ce compte. Demandez à l’organisateur du concours de vous inviter, ou connectez-vous avec votre mot de passe et liez-le sur votre page de profil.
oauth.ambiguous = Plusieurs comptes du jury correspondent à ce compte. Contactez l’organisateur du concours.
oauth.failed = La connexion a échoué. Veuillez réessayer.
oauth.cancelled = La connexion a été annulée.
oauth.linked = Le compte est lié. Vous pouvez maintenant vous connecter avec.
oauth.unlinked = Le compte est délié et vos autres sessions ont été déconnectées. Il ne permet de se reconnecter qu’une fois lié à nouveau ici.
oauth.linked.other = Ce compte est déjà lié à un autre compte du jury.
oauth.linked.accounts = Comptes liés
oauth.not.linked = Non lié
oauth.connect = Lier
oauth.unlink = Délier
oauth.provider.google = Google
oauth.provider.wikimedia = Wikimedia
oauth.unverified = Ce compte correspond à un compte du jury qui n’est pas encore confirmé. Acceptez l’invitation reçue par courriel, ou connectez-vous avec votre mot de passe, puis liez ce compte sur votre page de profil.
oauth.busy = Trop de connexions en même temps. Veuillez réessayer dans un instant.
oauth.linked.wiki.set = Le compte est lié, et son nom d’utilisateur est maintenant votre compte wiki.
oauth.linked.wiki.taken = Le compte est lié. Son nom d’utilisateur est le compte wiki d’un autre compte du jury : le vôtre reste inchangé. Contactez l’organisateur du concours.
oauth.link.unverified = Votre adresse n’est pas encore confirmée. Acceptez d’abord l’invitation reçue par courriel, puis liez le compte.
oauth.wiki.other.identity = Le compte du jury avec ce nom wiki était déjà lié à un compte Wikimedia. Connectez-vous avec celui-ci, ou contactez l’organisateur du concours.
oauth.wiki.ask.organizer = Votre compte wiki a été défini par l’organisateur du concours : demandez-lui de le changer.
oauth.linked.wiki.other = Le compte est lié. Son nom d’utilisateur n’est pas votre compte wiki, qui reste inchangé : demandez à l’organisateur du concours de le changer.
oauth.wiki.confirm.title = Définir votre compte wiki
oauth.wiki.confirm.text = Utiliser le compte Wikimedia lié {0} comme votre compte wiki ? Il sera alors marqué confirmé.
oauth.wiki.confirm.submit = L’utiliser
oauth.google.email.not.proof = Google ne confirme pas qui détient cette adresse (ce n’est pas une adresse Gmail ni Google Workspace). Acceptez d’abord l’invitation reçue par courriel, puis liez Google sur votre page de profil ; ensuite vous pourrez vous connecter avec.
oauth.choose.title = Choisissez votre compte du jury
oauth.choose.text = Plusieurs comptes du jury ont votre nom d’utilisateur Wikimedia comme compte wiki. Choisissez le vôtre ; un compte auquel on peut se connecter demande son mot de passe ou un lien envoyé à son adresse.
oauth.choose.no.email = Pas d’adresse
oauth.choose.no.contests = Aucun concours
oauth.choose.this = C’est mon compte
oauth.choose.password = Son mot de passe
oauth.choose.with.password = Choisir avec son mot de passe
oauth.choose.with.mail = M’envoyer un lien
oauth.choose.ask.organizer = Ce compte ne peut pas être choisi ici : contactez l’organisateur du concours.
oauth.choose.expired = Ce choix a expiré. Reconnectez-vous avec Wikimedia.
oauth.choose.password.wrong = Mot de passe incorrect. Rien n’a été lié.
oauth.choose.mail.sent = Un lien a été envoyé à l’adresse du compte. Ouvrez-le dans ce navigateur.
oauth.choose.mail.not.sent = Aucun lien n’a été envoyé (un lien vient d’être envoyé, ou le compte n’a pas d’adresse confirmée).
oauth.choose.proof.needed = Ce compte demande son mot de passe ou un lien envoyé par courriel.
oauth.choose.link.invalid = Ce lien n’est plus valable. Reconnectez-vous avec Wikimedia.
oauth.choose.confirm.text = Confirmez que ce compte du jury est le vôtre, pour y lier votre compte Wikimedia et vous connecter.
oauth.choose.confirm = Confirmer
oauth.choose.mail.subject = Confirmez votre compte du jury
oauth.choose.mail.body = Quelqu’un qui se connecte à l’outil du jury avec le compte Wikimedia {2} a choisi votre compte du jury. Si c’était vous, ouvrez ce lien dans le même navigateur dans les {1} minutes :\n{0}\n\nSinon, ignorez ce message : rien ne change.
oauth.unlinked.before = Ce compte a été délié de son compte du jury. Connectez-vous avec votre mot de passe, puis liez-le à nouveau sur votre page de profil.
oauth.choose.too.many = Trop de mots de passe incorrects. Reconnectez-vous avec Wikimedia plus tard.
