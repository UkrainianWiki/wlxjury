coi.match.now = Maintenant
coi.match.ended = N''est plus un conflit d''intérêts
coi.match.still = Toujours un conflit d''intérêts : {0}
coi.disqualify = Disqualifier les fichiers sélectionnés
coi.disqualify.help = Leurs votes sont conservés à part ; « Distribuer les nouveaux fichiers » ne les ajoute plus jamais. Cela ne change pas « Exclure les conflits d''intérêts » du tour : ses distributions suivantes n''excluent les nouveaux conflits que si c''est coché.
coi.requalify = Requalifier les fichiers sélectionnés
coi.requalify.help = Leurs votes reviennent tels quels. Un fichier toujours en conflit d''intérêts est proposé de nouveau à la disqualification.
coi.requalify.reason = Pourquoi
