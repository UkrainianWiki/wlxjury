account.search.add = Ajouter à ce concours
users.not.added.no.email = Non ajoutés, car le compte n''a pas de courriel pour une invitation et ne peut pas recevoir le rôle directement : {0}. Demandez à root.
# the notice to an account's owner when an admin adds it from search (accounts plan A-1, M1)
account.added.notice.subject = Vous avez été ajouté à {0}
account.added.notice.body = Bonjour,\n\nLes administrateurs de {0} ont ajouté votre compte de l''outil WLX Jury à ce concours, avec le rôle {1}. {2}\n\nAjouté par {3}. Pour toute question, écrivez aux administrateurs ou aux organisateurs du concours. Si vous ne participez pas à ce concours, vous pouvez ignorer ce message : rien d''autre n''a changé dans votre compte.\n\n{4}
account.added.notice.member = Vous pourrez ouvrir le concours à votre prochaine connexion.
account.added.notice.invited = Le rôle s''applique une fois que vous acceptez l''invitation que les administrateurs du concours vous envoient.
account.added.notice.sent = Son titulaire verra un avis dans l''outil à sa prochaine connexion, et a été informé par courriel.
account.added.notice.failed = Son titulaire verra un avis dans l''outil à sa prochaine connexion ; le courriel qui lui était destiné n''a pas pu être envoyé.
account.added.notice.no.email = Son titulaire verra un avis dans l''outil à sa prochaine connexion ; le compte n''a pas de courriel, aucun n''a donc été envoyé.
account.added.notice.in.app = Son titulaire verra un avis dans l''outil à sa prochaine connexion.
account.added.notice.no.access = Ce rôle ne vous ouvre pas les pages du concours.
account.added.notice.by = {0}, administrateur du concours
account.added.notice.by.unnamed = un administrateur du concours
account.search.tell.owner = Informer son titulaire par courriel
