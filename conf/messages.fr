# comptes : invitations, liens de mot de passe, changements d'adresse, installation (lot de sécurité S2)
not.a.member.invitation = Pas encore de compte ? Les comptes sont créés par les administrateurs du concours, qui vous envoient une invitation par courriel.
signin.password.link.hint = Mot de passe oublié, ou pas de connexion depuis longtemps ? Les anciens mots de passe expirent : demandez à l’administrateur de votre concours un lien pour en choisir un nouveau.
password.retired = mot de passe expiré
password.retired.hint = L''ancien mot de passe du compte a expiré sans être utilisé : envoyez une invitation pour en choisir un nouveau.
setup.needed = Cette installation n''a encore aucun compte. L''administrateur crée le premier sur la page d''installation (voir le guide de déploiement).
account.link.invalid.title = Ce lien ne peut pas être utilisé
account.link.invalid = Le lien n''est pas valide, a expiré ou a déjà été utilisé. Demandez à l''administrateur de votre concours de vous en envoyer un nouveau.
invitation.title = Choisissez votre mot de passe
invitation.reset.title = Choisissez un nouveau mot de passe
invitation.set.password = Choisissez un mot de passe pour vous connecter à WLX Jury. Votre adresse courriel est votre identifiant.
invitation.replaces.password = Choisissez un nouveau mot de passe. Il remplace l''ancien mot de passe de ce compte et ferme toutes ses autres sessions.
invitation.submit = Enregistrer le mot de passe et se connecter
new.password = Nouveau mot de passe
current.password = Mot de passe actuel
current.password.explain = Nécessaire pour changer votre mot de passe ou votre adresse courriel.
passwords.differ = Les mots de passe ne correspondent pas.
password.current.wrong = Le mot de passe actuel n''est pas correct.
password.others.not.allowed = Le mot de passe de ce compte ne peut pas être défini : il a été supprimé, ou il n''est pas membre de ce concours.
password.set.by.admin = Définir le mot de passe
password.set.by.admin.help = Laissez vide pour garder le mot de passe actuel. Un nouveau ferme toutes les sessions de la personne, et son adresse e-mail devra être vérifiée à nouveau. Donnez-le-lui en personne.
password.set.by.admin.done = Mot de passe défini. Toutes les sessions de la personne sont fermées, et son adresse e-mail devra être vérifiée à nouveau.
password.set.email.separately = Modifiez l''adresse e-mail et définissez le mot de passe en deux enregistrements séparés.
password.set.role.separately = Modifiez le rôle et définissez le mot de passe en deux enregistrements séparés.
password.set.no.login = Aucun mot de passe ne peut être défini pour ce compte : il n''a pas d''adresse e-mail, donc il se connecte avec Wikimedia, ou il n''a rien pour se connecter.
password.set.others.saved = Vos autres modifications ont été enregistrées ; le mot de passe n''a pas été défini.
email.change.title = Nouvelle adresse courriel
email.change.confirm = Faire de {0} l''adresse courriel de votre compte WLX Jury ?
email.change.confirm.button = Confirmer la nouvelle adresse
email.change.done = Votre adresse courriel est désormais {0}. Connectez-vous avec elle.
email.change.explain = Une nouvelle adresse prend effet une fois le lien qui lui est envoyé suivi.
email.change.sent = Un lien de confirmation a été envoyé à la nouvelle adresse. Elle prend effet une fois le lien suivi.
email.change.subject = Confirmez votre nouvelle adresse courriel pour WLX Jury
email.change.body = Bonjour,\n\nSur votre page de profil dans WLX Jury ({2}), l''outil de jury des concours photo Wiki Loves, vous avez demandé que cette adresse devienne l''adresse courriel de votre compte.\n\nSuivez ce lien dans les {1} heures pour le confirmer :\n{0}\n\nSi vous n''avez rien demandé, ignorez ce message : votre compte garde son adresse actuelle.
setup.title = Installer WLX Jury
setup.explain = Créez le premier compte, l''administrateur (root), avec le jeton d''installation de la configuration du serveur.
setup.token = Jeton d''installation
setup.submit = Créer le compte
setup.token.invalid = Le jeton d''installation n''est pas correct.
invitation.subject = Invitation au jury {0}
invitation.body = Bonjour,\n\n{1} vous invite au jury de {0}.\nSuivez ce lien dans les {3} jours pour choisir votre mot de passe et vous connecter :\n{2}\n\nVotre adresse courriel est votre identifiant.
invitation.subject.tool = Invitation à WLX Jury
invitation.body.tool = Bonjour,\n\n{2} vous invite dans WLX Jury, l''outil de jury des concours photo Wiki Loves.\nSuivez ce lien dans les {1} jours pour choisir votre mot de passe et vous connecter :\n{0}\n\nVotre adresse courriel est votre identifiant.
invitation.link = Suivez ce lien dans les {1} jours pour choisir votre mot de passe et vous connecter :\n{0}
password.link.subject = Choisissez un nouveau mot de passe pour WLX Jury
password.link.body = Bonjour,\n\nSuivez ce lien dans les {1} jours pour choisir un nouveau mot de passe pour WLX Jury :\n{0}\n\nVotre mot de passe actuel fonctionne jusque-là. Si vous ne vous y attendiez pas, ignorez ce message.
password.link.sent = Un lien pour choisir un nouveau mot de passe a été envoyé au compte. Le mot de passe actuel fonctionne jusqu''à son utilisation.
password.link.not.sent = Le lien n''a pas pu être envoyé. Réessayez plus tard.
password.link.no.email = Le compte n''a pas d''adresse courriel : aucun lien ne peut être envoyé.
wiki.account.invalid = Ce n''est pas un nom d''utilisateur wiki valide.
wiki.account.taken = Un autre compte a déjà ce compte wiki.
wiki.account.own.readonly = Votre compte wiki ne peut pas encore être modifié ici ; demandez à l’administrateur de votre concours.
wiki.account.unverified.hint = Non vérifié : n''importe qui a pu saisir ce compte wiki.
email.unverified.hint = Aucune invitation ni aucun lien envoyés à cette adresse n''ont encore été utilisés. Pour donner un nouveau rôle à ce compte, envoyez une invitation.
email.unverified.own.hint = Votre adresse n''est pas encore confirmée : demandez à l''administrateur de votre concours de vous envoyer une invitation par courriel.
unverified = non vérifié
role.needs.invitation.email = Ce compte n''a pas vérifié son adresse et n''en a aucune pour l''inviter : le rôle ne peut pas être donné.
invitation.send = Renvoyer l''invitation
invitation.sent = Une invitation a été envoyée. Le rôle s''applique une fois qu''elle est acceptée.
invitation.not.sent = L''invitation n''a pas pu être envoyée. Réessayez plus tard.
invitation.not.possible = Aucune invitation ne peut être envoyée à ce compte.
invitations.pending = Invitations pas encore acceptées
invitation.expires = Expire
users.invited = Invités (le rôle est donné une fois l''invitation acceptée) : {0}.
users.not.added.wiki.unverified = Non ajoutés, car le compte wiki appartient à un compte qui ne l''a pas vérifié : {0}. Ajoutez-les par courriel.
users.invitations.not.sent = Invitations qui n''ont pas pu être envoyées : {0}.
invitation.password.placeholder = celui que vous choisirez avec le lien ci-dessous
invitation.cancel = Annuler
invitation.cancelled = L''invitation a été annulée.
invitation.set.password.wiki = Choisissez un mot de passe pour vous connecter à WLX Jury. Votre compte wiki, {0}, est votre identifiant.
invitations.recent = Invitations
share.link.create = Créer un lien à transmettre
share.link.title = Un lien pour choisir le mot de passe
share.link.for = Pour : {0}
share.link.invitation.help = Copiez ce lien et envoyez-le vous-même à la personne. Il choisit le mot de passe du compte, une seule fois, et la connecte ; le rôle s''applique alors.
share.link.reset.help = Copiez ce lien et envoyez-le vous-même à la personne. Il choisit un nouveau mot de passe pour le compte, une seule fois, et ferme toutes ses autres sessions. Le mot de passe actuel fonctionne jusque-là.
share.link.reset.explain = Un lien qui choisit un nouveau mot de passe, à envoyer vous-même à la personne plutôt que par courriel. En créer un rend inutilisables les liens précédents non utilisés.
share.link.expires = Expire le {0}.
share.link.warning = Toute personne ayant ce lien peut choisir le mot de passe de ce compte : envoyez-le seulement à la personne, en privé.
share.link.once = Ce lien n''est affiché que maintenant. Recharger ou renvoyer cette page crée un nouveau lien et rend celui-ci inutilisable ; tout nouveau lien, par courriel ou à transmettre, aussi. Sa création a rendu inutilisables les liens précédents non utilisés du même type, y compris ceux envoyés par courriel (la réinitialisation du mot de passe par root aussi).
share.link.copy = Copier
share.link.copied = Copié
share.link.back = Retour
share.link.no.login = Le compte n''a ni adresse courriel ni compte wiki pour se connecter : aucun lien ne peut être créé.
share.link.wikimedia = Le compte n''a pas d''adresse courriel : la personne se connecte avec Wikimedia, par son compte wiki ; aucun lien de mot de passe n''est créé pour lui.
share.link.wikimedia.note = Se connecte avec Wikimedia, en tant que {0}
