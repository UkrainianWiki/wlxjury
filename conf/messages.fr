coi.code.min_mpx = Trop peu de mégapixels
coi.code.category = Catégorie
coi.code.date = Date
coi.code.manual = Retiré à la main
coi.history = Historique
coi.history.help = Chaque disqualification et requalification des fichiers du tour depuis que cet historique est tenu, la plus récente d''abord.
coi.history.none = Aucun fichier de ce tour n''a été disqualifié ni requalifié depuis que cet historique est tenu.
coi.history.limited = Seules les {0} dernières sont affichées.
