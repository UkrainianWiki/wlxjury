<!-- Production's logging, shipped in the release ZIP as conf/logback-production.xml: the systemd
     unit (wlxjury-infra's wlxjury.service.j2) starts the app with
     -Dlogger.file=/opt/wlxjury/current/conf/logback-production.xml, so a release brings its own
     loggers and a backout restores the old ones (docs/plans/2026-10-30-logging-config-in-releases.md).
     Logback finds only logback.xml or logback-test.xml by itself: this file changes nothing in
     development (conf/logback.xml) or tests. Checked by deployment.ProductionConfigSpec. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%date [%level] %logger{36} - %message%n%xException</pattern></encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/var/log/wlxjury/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>/var/log/wlxjury/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>%date [%level] %logger{36} - %message%n%xException</pattern></encoder>
    </appender>
    <logger name="application" level="INFO"/>
    <!-- conflicts of interest removed from rounds (db.scalikejdbc.RoundConflicts): kept nowhere else -->
    <logger name="coi" level="INFO"/>
    <!-- refused personal API tokens (services.ApiTokenService): unknown ones at INFO, by prefix -->
    <logger name="services.ApiTokenService" level="INFO"/>
    <!-- support diagnostics (docs/plans/2026-11-18-support-diagnostics.md, D-0b; operations §1):
         the imports' summaries (import_done, monument_lists_done), the jobs' outcomes (job_done,
         job_failed), account and role changes, the round admin's changes (freeze_release,
         juror_add, juror_reassign) and a juror's refused gallery or large view of a stopped round
         (round_access_refused). round.counts stays at WARN: its INFO is the periodic recompute's
         summary, its failures are WARN -->
    <logger name="services.imports" level="INFO"/>
    <logger name="services.jobs" level="INFO"/>
    <logger name="security.account" level="INFO"/>
    <logger name="security.roles" level="INFO"/>
    <logger name="round.admin" level="INFO"/>
    <logger name="round.access" level="INFO"/>
    <!-- a request for another host (AllowedHostsFilter): ErrorHandler logs it once as client_error;
         the filter's own WARN would double every scanner's request -->
    <logger name="play.filters.hosts.AllowedHostsFilter" level="ERROR"/>
    <!-- a refused CSRF token: CsrfErrorHandler logs it once as csrf_failure (with a reference and
         the path only); Play's own WARN would double every bot's token-less POST and quote the URI -->
    <logger name="play.filters.CSRF" level="ERROR"/>
    <!-- the MariaDB driver logs every server error at WARN with its message, bound values
         included (e.g. "Duplicate entry '<email>'"); the app logs failures itself without them
         (db.scalikejdbc.SqlLogging, ErrorHandler) -->
    <logger name="org.mariadb.jdbc" level="ERROR"/>
    <root level="WARN"><appender-ref ref="STDOUT"/><appender-ref ref="FILE"/></root>
</configuration>
