# docker-compose.yml's settings. Copy to .env (git-ignored) and fill in, or run
# scripts/docker/generate-env.sh, which adds random values for the empty secrets below to .env
# and never replaces a value already there. run-dev.sh sources the same .env (shell syntax:
# NAME=value, no spaces); compose reads only the names it uses.

# Secrets: required (compose stops with "set it in .env" if one is missing or empty)
# The MariaDB container's application password, and the app's
WLXJURY_COMPOSE_DB_PASSWORD=
# MariaDB's root password (the app never uses it). Given, not generated by the image, which
# would print a generated one in its log.
WLXJURY_COMPOSE_DB_ROOT_PASSWORD=
# Play's signing key: 32 bytes or more. Changing it signs everyone out.
PLAY_HTTP_SECRET_KEY=
# For /setup, which creates the first account (root): 32 characters or more. Optional; without
# it /setup is a 404. Unused once an account exists.
WLXJURY_SETUP_TOKEN=

# Not secret: defaults in docker-compose.yml
# The host names the app answers to, comma-separated, without a port (others get 400)
# WLXJURY_ALLOWED_HOSTS=localhost
# The URL its links and thumbnails use: change it with the port below
# WLXJURY_HOST=http://localhost:9000/
# Where the app's port is published: 127.0.0.1 keeps it off the network (there is no TLS).
# A published port skips the host firewall's input rules (ufw): never bind 0.0.0.0 counting on
# the firewall; put a TLS proxy on the host in front of 127.0.0.1 instead
# (docs/investigations/2026-11-04-simpler-deployment.md, §3.1).
# WLXJURY_HTTP_BIND=127.0.0.1
# WLXJURY_HTTP_PORT=9000
# JAVA_OPTS (the heap, migrations, hosts) is set in docker-compose.yml, not here: to change it,
# set the whole value in a docker-compose.override.yml.
# The image to run (sbt Docker/publishLocal tags wlxjury:local and wlxjury:<version>)
# WLXJURY_IMAGE=wlxjury:local
