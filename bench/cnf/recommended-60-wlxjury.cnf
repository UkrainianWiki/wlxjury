# Production-like measurements, 2026-10-10. Install as:
# /etc/mysql/mariadb.conf.d/60-wlxjury.cnf after conversion to InnoDB.
# Read docs/plans/2026-10-07-prod-like-benchmark.md for conditions and limits.
#
# This is exactly the bp512 configuration tested with PR #183 / V55.1.
# Full dataset: concurrent physical buffer-pool reads 8660 -> 24;
# category-round completion 4.987 -> 3.597 s; gallery alone p95 remains 19 ms.
# Concurrent vote/gallery p95 was 54/481 ms vs 43/396 at 128M: no demonstrated
# tail-latency win. Choose 512M for cache headroom and faster solo creation,
# not as a guarantee of better p95 on production storage.
# MariaDB peak sampled RSS: 683 MiB for this suite, not a hard memory bound.
#
# Shared-server budget (runbook): app 1300, Apache/WordPress 1000,
# midnight statistics 1300, OS 300 MiB; about 1000 MiB remains for MariaDB.
# Global configured buffers with this override total about 785 MiB:
# 512 InnoDB + 128 key cache + 128 Aria + 16 log buffer + 1 query cache.
# Leave about 215 MiB for other memory; connection/query buffers can grow.
# WordPress and stats are absent from the benchmark: monitor RSS/swap with
# all production workloads. 768M would put that buffer sum at 1041 MiB;
# the measured 1G/1536M points do not fit the shared-server allowance.
#
# Everything else inherits the active production files. In particular:
# durable innodb_flush_log_at_trx_commit=1; redo file 96M; O_DIRECT;
# innodb_io_capacity=200; tmp_table_size/max_heap_table_size=16M;
# key_buffer_size=128M; aria_pagecache_buffer_size=128M;
# query_cache_type=OFF (existing 1M allocation); max_connections=151;
# table_open_cache=2000. Alternatives were not justified by this suite.
# Avoid multiplying per-connection temporary buffers from the disk-temp
# counter alone: gallery queries create disk temporary tables at every pool size.
[mariadb]
innodb_buffer_pool_size = 512M
