diff --git a/build.sbt b/build.sbt
index 35a8c56..9c2c570 100644
--- a/build.sbt
+++ b/build.sbt
@@ -3,6 +3,14 @@ import Dependencies._
 
 ThisBuild / Test / fork := true
 
+// Tests use the wikis anonymously: LoginInfo.fromEnv ignores SCALAWIKI_LOGIN / SCALAWIKI_PASSWORD
+// in the forked test JVM unless sbt runs with -Dscalawiki.allowTestLogin=true (no CI job does).
+// Specs that read live wikis at volume run only with -Dscalawiki.live=true.
+ThisBuild / Test / javaOptions ++= {
+  val anonymous = !sys.props.get("scalawiki.allowTestLogin").contains("true")
+  Seq(s"-Dscalawiki.anonymous=$anonymous") ++ sys.props.get("scalawiki.live").map(v => s"-Dscalawiki.live=$v")
+}
+
 // UTF-8 stdout/stderr so Cyrillic in reports/tests isn't mangled to '?'.
 ThisBuild / Test / javaOptions ++= Seq(
   "-Dfile.encoding=UTF-8",
diff --git a/scalawiki-core/src/main/scala/org/scalawiki/LoginInfo.scala b/scalawiki-core/src/main/scala/org/scalawiki/LoginInfo.scala
index f063dbf..1844297 100644
--- a/scalawiki-core/src/main/scala/org/scalawiki/LoginInfo.scala
+++ b/scalawiki-core/src/main/scala/org/scalawiki/LoginInfo.scala
@@ -10,14 +10,22 @@ case class LoginInfoValue(login: String, password: String) extends LoginInfo
 
 object LoginInfo {
 
+  /** Set to `true` (the build sets it for tests) to make [[fromEnv]] ignore the
+    * environment: no bot logs in as `SCALAWIKI_LOGIN` then. A test that must log in
+    * needs `-Dscalawiki.allowTestLogin=true` on sbt's command line, which no CI job sets.
+    */
+  val AnonymousProperty = "scalawiki.anonymous"
+
   def fromEnv(
       loginProp: String = "SCALAWIKI_LOGIN",
       passwordProp: String = "SCALAWIKI_PASSWORD"
   ): Option[LoginInfo] =
-    for (
-      login <- sys.env.get(loginProp);
-      password <- sys.env.get(passwordProp)
-    )
-      yield LoginInfoValue(login, password)
+    if (sys.props.get(AnonymousProperty).contains("true")) None
+    else
+      for (
+        login <- sys.env.get(loginProp).filter(_.nonEmpty);
+        password <- sys.env.get(passwordProp).filter(_.nonEmpty)
+      )
+        yield LoginInfoValue(login, password)
 
 }
