diff --git a/roles/wlxjury_app/defaults/main.yml b/roles/wlxjury_app/defaults/main.yml
index 25427ad..db2af28 100644
--- a/roles/wlxjury_app/defaults/main.yml
+++ b/roles/wlxjury_app/defaults/main.yml
@@ -26,6 +26,26 @@ wlxjury_restore_minimum_free_bytes: 2147483648
 wlxjury_session_end_timeout_seconds: 600
 wlxjury_systemd_dropin_dir: /etc/systemd/system/wlxjury.service.d
 
+# Retention for wlxjury-release prune, which runs after every successful reopen
+# (docs/deployment.md, "Retention"): the releases kept besides the current one,
+# and the pre-deployment dumps kept by count; keep_backup_days 0 turns the age
+# rule off (releases are infrequent). The long-term backup is separate.
+wlxjury_keep_previous_releases: 4
+wlxjury_keep_backup_dumps: 5
+wlxjury_keep_backup_days: 0
+
+# The app's image cache (wlxjury.thumbs.local-path). Only the app writes it and
+# serves it (ImageProxyController); wlxjury-release refuses to deploy while it
+# is group- or world-writable.
+wlxjury_image_cache_dir: /var/www/jury-images
+
+# monit's alert-only check of the app (conf/monit in the app repository), when
+# monit is installed. Never a restart: that would bypass the deployment hold.
+wlxjury_monit: true
+# The app repository's conf/monit folder on the controller, at the reviewed
+# version (wlxjury-check and wlxjury), when wlxjury_monit is on.
+wlxjury_monit_source: REPLACE_ME
+
 # The app repository's scripts/deployment folder on the controller, at the
 # reviewed version: wlxjury-deploy and wlxjury-release are installed from it.
 wlxjury_tools_source: REPLACE_ME
