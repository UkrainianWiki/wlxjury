diff --git a/roles/wlxjury_app/defaults/main.yml b/roles/wlxjury_app/defaults/main.yml
index 25427ad..c106769 100644
--- a/roles/wlxjury_app/defaults/main.yml
+++ b/roles/wlxjury_app/defaults/main.yml
@@ -26,6 +26,25 @@ wlxjury_restore_minimum_free_bytes: 2147483648
 wlxjury_session_end_timeout_seconds: 600
 wlxjury_systemd_dropin_dir: /etc/systemd/system/wlxjury.service.d
 
+# Retention for wlxjury-release prune, which runs after every successful reopen
+# (docs/deployment.md, "Retention"): the releases kept besides the current one,
+# and the pre-deployment dumps kept by count and by age. restic keeps the
+# long-term backups.
+wlxjury_keep_previous_releases: 2
+wlxjury_keep_backup_dumps: 3
+wlxjury_keep_backup_days: 14
+
+# The app's image cache (wlxjury.thumbs.local-path). Only the app writes it and
+# serves it (ImageProxyController); wlxjury-release refuses to deploy while it
+# is group- or world-writable.
+wlxjury_image_cache_dir: /var/www/jury-images
+
+# monit's alert-only check of the app (conf/monit in the app repository), when
+# monit is installed. Never a restart: that would bypass the deployment hold.
+wlxjury_monit: true
+# The app repository's conf/monit folder on the controller, at the reviewed version.
+wlxjury_monit_source: "{{ wlxjury_tools_source }}/../../conf/monit"
+
 # The app repository's scripts/deployment folder on the controller, at the
 # reviewed version: wlxjury-deploy and wlxjury-release are installed from it.
 wlxjury_tools_source: REPLACE_ME
diff --git a/roles/wlxjury_app/handlers/main.yml b/roles/wlxjury_app/handlers/main.yml
index 0fc6cbf..5453525 100644
--- a/roles/wlxjury_app/handlers/main.yml
+++ b/roles/wlxjury_app/handlers/main.yml
@@ -3,3 +3,16 @@
   ansible.builtin.systemd_service:
     daemon_reload: true
   listen: wlxjury reload systemd
+
+# monit -t first: a broken control file would stop monit on reload, and with it
+# the server's other checks.
+- name: Check monit's configuration
+  ansible.builtin.command:
+    argv: [monit, -t]
+  changed_when: false
+  listen: wlxjury reload monit
+
+- name: Reload monit
+  ansible.builtin.command:
+    argv: [monit, reload]
+  listen: wlxjury reload monit
diff --git a/roles/wlxjury_app/tasks/main.yml b/roles/wlxjury_app/tasks/main.yml
index 1bdc8b7..ab91f24 100644
--- a/roles/wlxjury_app/tasks/main.yml
+++ b/roles/wlxjury_app/tasks/main.yml
@@ -110,6 +110,16 @@
     # Not the drop-in directory: package scripts remove it when empty, and the
     # deployment tools create it whenever they write their restart hold.
 
+# The folder only; its files are the app's (0644 files, 0755 folders, written
+# through temporary files and moves). Production's was 0777 until 2026-11.
+- name: Create the image cache directory, writable by the app only
+  ansible.builtin.file:
+    path: "{{ wlxjury_image_cache_dir }}"
+    state: directory
+    owner: "{{ wlxjury_user }}"
+    group: "{{ wlxjury_group }}"
+    mode: "0755"
+
 - name: Write the configuration
   ansible.builtin.import_tasks: config.yml
 
@@ -122,3 +132,7 @@
 
 - name: Install the service
   ansible.builtin.import_tasks: service.yml
+
+- name: Install monit's check of the app
+  ansible.builtin.import_tasks: monit.yml
+  when: wlxjury_monit
diff --git a/roles/wlxjury_app/tasks/monit.yml b/roles/wlxjury_app/tasks/monit.yml
new file mode 100644
index 0000000..525ca0d
--- /dev/null
+++ b/roles/wlxjury_app/tasks/monit.yml
@@ -0,0 +1,36 @@
+---
+# conf/monit from the app repository: an alert-only program check. monit itself,
+# its mail settings and its other checks belong to the server, not this role.
+- name: Find monit
+  ansible.builtin.stat:
+    path: /etc/monit/conf.d
+  register: wlxjury_monit_dir
+
+- name: Create the folder for monit's check script
+  ansible.builtin.file:
+    path: /usr/local/lib/wlxjury
+    state: directory
+    owner: root
+    group: root
+    mode: "0755"
+  when: wlxjury_monit_dir.stat.isdir | default(false)
+
+- name: Install monit's check script
+  ansible.builtin.copy:
+    src: "{{ wlxjury_monit_source }}/wlxjury-check"
+    dest: /usr/local/lib/wlxjury/monit-check
+    owner: root
+    group: root
+    mode: "0755"
+  when: wlxjury_monit_dir.stat.isdir | default(false)
+  notify: wlxjury reload monit
+
+- name: Install monit's check of the app
+  ansible.builtin.copy:
+    src: "{{ wlxjury_monit_source }}/wlxjury"
+    dest: /etc/monit/conf.d/wlxjury
+    owner: root
+    group: root
+    mode: "0644"
+  when: wlxjury_monit_dir.stat.isdir | default(false)
+  notify: wlxjury reload monit
