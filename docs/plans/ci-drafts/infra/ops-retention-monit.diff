@@ -110,6 +111,17 @@
     # Not the drop-in directory: package scripts remove it when empty, and the
     # deployment tools create it whenever they write their restart hold.
 
+# The folder only; its files are the app's (0644 files, 0755 folders, written
+# through temporary files and moves). wlxjury-release refuses to deploy while it
+# isn't the service user's or is group- or world-writable.
+- name: Create the image cache directory, writable by the app only
+  ansible.builtin.file:
+    path: "{{ wlxjury_image_cache_dir }}"
+    state: directory
+    owner: "{{ wlxjury_user }}"
+    group: "{{ wlxjury_group }}"
+    mode: "0755"
+
 - name: Write the configuration
   ansible.builtin.import_tasks: config.yml
 
@@ -122,3 +134,7 @@
 
 - name: Install the service
   ansible.builtin.import_tasks: service.yml
+
+- name: Install monit's check of the app
+  ansible.builtin.import_tasks: monit.yml
+  when: wlxjury_monit
diff --git a/roles/wlxjury_app/tasks/monit.yml b/roles/wlxjury_app/tasks/monit.yml
new file mode 100644
index 0000000..bbd4999
--- /dev/null
+++ b/roles/wlxjury_app/tasks/monit.yml
@@ -0,0 +1,52 @@
+---
+# conf/monit from the app repository: an alert-only program check. monit itself,
+# its mail settings and its other checks belong to the server, not this role.
+- name: Find monit
+  ansible.builtin.stat:
+    path: /etc/monit/conf.d
+  register: wlxjury_monit_dir
+
+- name: Install monit's check of the app
+  when: wlxjury_monit_dir.stat.isdir | default(false)
+  block:
+    - name: Create the folder for monit's check script
+      ansible.builtin.file:
+        path: /usr/local/lib/wlxjury
+        state: directory
+        owner: root
+        group: root
+        mode: "0755"
+
+    - name: Install monit's check script
+      ansible.builtin.copy:
+        src: "{{ wlxjury_monit_source }}/wlxjury-check"
+        dest: /usr/local/lib/wlxjury/monit-check
+        owner: root
+        group: root
+        mode: "0755"
+      notify: wlxjury reload monit
+
+    - name: Install the check
+      ansible.builtin.copy:
+        src: "{{ wlxjury_monit_source }}/wlxjury"
+        dest: /etc/monit/conf.d/wlxjury
+        owner: root
+        group: root
+        mode: "0644"
+      notify: wlxjury reload monit
+
+    # A control file monit refuses would stop it at the next reload, and with it
+    # the server's other checks.
+    - name: Check monit's configuration
+      ansible.builtin.command:
+        argv: [monit, -t]
+      changed_when: false
+  rescue:
+    - name: Remove the check monit refused
+      ansible.builtin.file:
+        path: /etc/monit/conf.d/wlxjury
+        state: absent
+
+    - name: Stop with monit's verdict
+      ansible.builtin.fail:
+        msg: monit -t refused the configuration with conf/monit/wlxjury; the file was removed again.
