{
  "name": "wlxjury-js",
  "private": true,
  "scripts": {
    "test": "jest",
    "lint": "cd .. && eslint -c javascript-test/eslint.config.mjs public/javascripts && stylelint --config javascript-test/stylelint.config.mjs --report-needless-disables public/stylesheets/main.css public/stylesheets/theme.css",
    "lint:selftest": "node lint-selftest/run.mjs"
  },
  "devDependencies": {
    "bootstrap": "5.3.8",
    "browserslist": "4.29.4",
    "caniuse-lite": "1.0.30001817",
    "eslint": "10.13.0",
    "eslint-plugin-compat": "7.0.2",
    "globals": "17.13.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jquery": "3.7.1",
    "stylelint": "17.16.0",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "tom-select": "2.6.2"
  },
  "jest": {
    "rootDir": "..",
    "roots": ["<rootDir>/javascript-test", "<rootDir>/public/javascripts"],
    "coverageProvider": "v8",
    "collectCoverageFrom": [
      "public/javascripts/*.js",
      "!public/javascripts/{jquery.hotkeys,jquery.raty,unitegallery,ug-theme-tiles}.js"
    ],
    "coverageDirectory": "<rootDir>/target/jest-coverage",
    "coverageReporters": ["lcov", "text-summary", "json-summary"]
  }
}
